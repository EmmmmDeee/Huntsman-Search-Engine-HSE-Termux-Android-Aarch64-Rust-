FROM rust:1.99.0-bookworm

WORKDIR /work

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
RUN rustup component add rustfmt clippy

COPY . /work/

ENV CARGO_TERM_COLOR=never

# Live provider discriminator: the authenticated subscription endpoint must
# reject an intentionally invalid key. The response body is never printed.
RUN status="$(curl --silent --show-error --output /tmp/hibp-invalid-body \
        --write-out '%{http_code}' --max-time 20 \
        --header 'Accept: application/json' \
        --header 'User-Agent: huntsman-hibp-verifier/2026-10-05' \
        --header 'hibp-api-key: huntsman-intentionally-invalid-verifier-key' \
        'https://haveibeenpwned.com/api/v3/subscription/status')" \
    && rm -f /tmp/hibp-invalid-body \
    && echo "HIBP_INVALID_KEY_HTTP_STATUS=${status}" \
    && test "${status}" = '401'

RUN cargo fmt --check
RUN cargo check --locked --all-targets --all-features

# Live product-path falsification: execute the real production CLI and transport
# against HIBP. It must classify the same invalid key as EX_NOPERM (77), report
# HTTP 401, emit no stdout, and never echo the key in stderr.
RUN set +e; \
    HIBP_API_KEY='huntsman-intentionally-invalid-verifier-key' \
        cargo run --locked --quiet -- hibp subscription \
        >/tmp/hibp-rust-out 2>/tmp/hibp-rust-err; \
    code="$?"; \
    set -e; \
    echo "HIBP_RUST_INVALID_KEY_EXIT=${code}"; \
    test "${code}" = '77'; \
    test ! -s /tmp/hibp-rust-out; \
    grep -Fq 'HTTP 401' /tmp/hibp-rust-err; \
    if grep -Fq 'huntsman-intentionally-invalid-verifier-key' /tmp/hibp-rust-err; then \
        echo 'HIBP verifier detected credential leakage' >&2; \
        exit 1; \
    fi; \
    rm -f /tmp/hibp-rust-out /tmp/hibp-rust-err

RUN cargo test --locked --all-features hibp::tests -- --nocapture
RUN cargo test --locked --all-features --test hibp_cli -- --nocapture
RUN cargo test --locked --all-features --test hibp_build -- --nocapture
RUN cargo clippy --locked --all-targets --all-features -- -D warnings
RUN cargo test --locked --all-features

CMD ["sh", "-c", "echo HIBP_ROOT_VERIFIER_COMPLETE; sleep 3600"]
