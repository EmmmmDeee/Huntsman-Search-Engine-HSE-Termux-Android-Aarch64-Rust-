# GreyNoise — internet-wide noise classification
# Signup: https://www.greynoise.io/
# Docs: https://docs.greynoise.io/
# Cost: Free community tier + paid enterprise
# Format: API key (key header)
# HUNTSMAN_GREYNOISE_KEY=your_greynoise_api_key_here

# URLScan.io — URL/domain sandbox scanning
# Signup: https://urlscan.io/
# Docs: https://urlscan.io/docs/api/
# Cost: Free tier + paid plans
# Format: API key (API-Key header)
# HUNTSMAN_URLSCAN_KEY=your_urlscan_api_key_here

# AbuseIPDB — IP abuse/reputation database
# Signup: https://www.abuseipdb.com/
# Docs: https://docs.abuseipdb.com/
# Cost: Free tier + paid plans
# Format: API key (Key header)
# HUNTSMAN_ABUSEIPDB_KEY=your_abuseipdb_api_key_here

# PulseDive — threat intelligence platform
# Signup: https://pulsedive.com/
# Docs: https://pulsedive.com/api/
# Cost: Free tier + paid plans
# Format: API key (key query param)
