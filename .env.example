# Huntsman Search Engine (HSE) — API Key Configuration
# Copy this file to ~/.huntsman.env and fill in your API keys.
# HSE reads from ~/.huntsman.env on startup; keys are never logged or exposed.
# All keys are optional. Omitting a key disables that paid module.

# ============================================================================
# PAID MODULES (breach/OSINT/geolocation intelligence)
# ============================================================================

# OathNet Pro — breach + stealer intelligence, highest-confidence data
# Signup: https://oathnet.org
# Docs: https://oathnet.org/docs
# Cost: Multiplier-tier service ($/lookup), session-bundled
# Format: Bearer token (opaque)
# HUNTSMAN_OATHNET_KEY=your_oathnet_bearer_token_here

# SeekNow (see-know.eu) — 212M+ breach records, stealer logs, OSINT intelligence
# Signup: https://see-know.eu/signup
# Dashboard: https://see-know.eu/account/dashboard
# Official Docs: https://see-know.eu/docs/api
# Cost: Plans from Beginner (100/day) to Enterprise (unlimited daily credits)
# Format: API key (typically 64+ characters, starts with "seek-")
#
# Authentication: Automatically uses X-API-Key header (per official spec)
# Endpoints: 24 endpoints across search, stealer, social, network, domain, gaming, enterprise
# Rate Limits: Managed automatically via rate-limit headers on every response
# Credit System: Most endpoints = 1 credit, stealer logs = 2, enterprise = 5, credits/status = 0
#
# HSE Automatic Features:
#   • Auto-detects daily credit limit from /credits endpoint (free, no budget consumed)
#   • Dynamic per-scan budget scaling (limit / 20, clamped 300–2500)
#   • Intelligent endpoint routing by target type (email, username, phone, domain, ip, name)
#   • Automatic fallback on quota exhaustion (module stops, others continue)
#   • Request caching to avoid duplicate lookups (in-process cache, 1024 entries)
#   • Response archiving to ~/.hse/raw_archive/see-know/ for audit/replay
#   • API key fingerprinting (shows provider:head…tail in results, never full secret)
#
# HUNTSMAN_SEEKNOW_KEY=seek-your-api-key-here

# Shodan — IP/domain/cert intelligence
# Signup: https://www.shodan.io/
# Docs: https://developer.shodan.io/api
# Cost: Paid plans required for most endpoints
# Format: API key (opaque string)
# HUNTSMAN_SHODAN_KEY=your_shodan_api_key_here

# Censys — certificate + IP/domain data
# Signup: https://censys.io/
# Docs: https://censys.io/api/
# Cost: Paid plans required
# Format: Two-part auth: APP_ID:API_SECRET
# HUNTSMAN_CENSYS_ID=your_app_id
# HUNTSMAN_CENSYS_SECRET=your_api_secret

# SecurityTrails — historical DNS + domain intelligence
# Signup: https://securitytrails.com/
# Docs: https://docs.securitytrails.com/
# Cost: Paid plans required
# Format: API key (opaque string)
# HUNTSMAN_SECURITYTRAILS_KEY=your_securitytrails_key_here

# VirusTotal — malware/phishing/infrastructure scanning
# Signup: https://www.virustotal.com/
# Docs: https://developers.virustotal.com/reference
# Cost: Free tier + paid plans
# Format: API key (opaque string)
# HUNTSMAN_VIRUSTOTAL_KEY=your_virustotal_api_key_here

# Hunter.io — corporate email discovery
# Signup: https://hunter.io/
# Docs: https://hunter.io/api
# Cost: Paid plans required
# Format: API key (opaque string)
# HUNTSMAN_HUNTER_IO_KEY=your_hunter_io_key_here

# ProxyCurl — LinkedIn profile extraction
# Signup: https://nubela.co/proxycurl/
# Docs: https://nubela.co/proxycurl/docs
# Cost: Paid plans required
# Format: Bearer token (opaque string)
# HUNTSMAN_PROXYCURL_KEY=your_proxycurl_bearer_token_here

# ============================================================================
# API CONFIGURATION OVERRIDES (optional)
# ============================================================================

# Override the default API base URL for a service (self-hosting, an alternate
# mirror, testing). Divergent hosts are honoured but logged at WARN.
# HUNTSMAN_SEEKNOW_BASE=https://see-know.eu/api/v1

# SeekNow per-scan credit budget cap (default: dynamic, based on daily plan limit)
# Set to a specific number to override auto-detection (e.g., 160 for testing)
# HUNTSMAN_SEEKNOW_SCAN_CAP=160

# ============================================================================
# OPTIONAL: ADDITIONAL CONFIGURATION
# ============================================================================

# Enable debug logging (values: debug, info, warn, error)
# RUST_LOG=debug

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================
#
# 1. Copy this file to your home directory:
#    cp .env.example ~/.huntsman.env
#
# 2. Edit ~/.huntsman.env and add your API keys:
#    nano ~/.huntsman.env
#
# 3. Source the file to load the environment (HSE loads it automatically):
#    source ~/.huntsman.env
#
# 4. Verify your setup:
#    hse doctor
#
# 5. Run a test scan:
#    hse scan --kind email --value test@example.com --depth 1
#
# ============================================================================
# SECURITY NOTES
# ============================================================================
#
# - ~/.huntsman.env is read-only to the user (mode 0600) — never commit it
# - API keys are NEVER logged to console or saved to scan results
# - All requests are made over HTTPS with TLS verification
# - Keys are stored in-process only, never written to disk except ~/.huntsman.env
# - Each module receives only its own API key (no cross-module key exposure)
#
# ============================================================================
