# HUNTSMAN_TROVE_KEY=your_trove_api_key_here

# ============================================================================
# API CONFIGURATION OVERRIDES (optional)
# ============================================================================

# Override the default API base URL for a service (self-hosting, an alternate
# mirror, testing). Divergent hosts are honoured but logged at WARN.
# HUNTSMAN_SEEKNOW_BASE=https://see-know.ru/api/v1

# SeekNow per-scan credit budget cap (default: dynamic, based on daily plan limit)
# Set to a specific number to override auto-detection (e.g., 160 for testing)
# HUNTSMAN_SEEKNOW_SCAN_CAP=160

# SeekNow browser-automation fallback login (used ONLY when HUNTSMAN_SEEKNOW_KEY
# above is not configured). This is your SeekNow account's own email/password —
# not a separate signup. Optional: leave unset to rely on the API key instead.
# HUNTSMAN_SEEKNOW_EMAIL=your-account@example.com
# HUNTSMAN_SEEKNOW_PASSWORD=your-account-password

# Custom email domain list for name_intel permutation module (comma-separated)
# Default: a built-in list of major email providers
# HUNTSMAN_EMAIL_DOMAINS=gmail.com,yahoo.com,outlook.com

# Outbound HTTP proxy for search-engine modules (format: http://host:port)
# HUNTSMAN_SEARCH_PROXY=http://127.0.0.1:8888

# NOT an alternative way to set the proxy above — HUNTSMAN_SEARCH_PROXY is the
# only proxy HSE itself uses. This names an ADDITIONAL proxy host HSE does not
# manage (e.g. one set system-wide by another tool) purely so HSE never mistakes
# its own egress path for a scan target.
# HUNTSMAN_PROXY=http://127.0.0.1:9999

# Custom DNS resolver list for network rotation (comma-separated IP addresses)
# Default: system resolvers
# HUNTSMAN_DNS_RESOLVERS=8.8.8.8,1.1.1.1,9.9.9.9

# Self-refilling proxy pool sourced from your own published feed URL(s)
# (comma-separated). Each candidate is probe-validated before use.
# HUNTSMAN_PROXY_FEEDS=https://example.com/my-proxy-list.txt

# DNS-over-HTTPS resolver override. Set to "off"/"none"/empty to disable DoH
# entirely. Default: https://1.1.1.1/dns-query — deliberately the literal IP,
# not a hostname, so resolving the DoH endpoint itself never needs DNS first.
# HUNTSMAN_DOH_URL=https://1.1.1.1/dns-query

# ============================================================================
# OPERATIONAL / DIAGNOSTIC OVERRIDES (optional — sane defaults apply)
# ============================================================================

# Where `hse update`/the self-update path locates this install's source tree.
# install.sh writes this automatically; only set it yourself if you moved the
# source tree. Falls back to common locations, then binary-path traversal.
# HUNTSMAN_INSTALL_DIR=/path/to/huntsman-search-engine

# Retained in-memory diagnostic log lines (for `hse doctor`/support bundles)
# Default: 20000
# HUNTSMAN_LOG_BUFFER_LINES=20000

# hse serve's background DB-prune cadence, in seconds (minimum 3600)
# Default: 86400 (24h)
# HUNTSMAN_TIDY_INTERVAL_SECS=86400

# hse serve's background engine-health sweep cadence, in seconds (minimum 60)
# Default: 900
# HUNTSMAN_ENGINE_HEALTH_SECS=900

# Throttle between automatic self-update checks, in seconds (minimum 1800)
# Default: 21600 (6h)
# HUNTSMAN_AUTO_UPDATE_INTERVAL_SECS=21600

# Retain raw provider response payloads alongside parsed entities (privacy-
# relevant: this is ON by default). Set to "0"/"off"/"false" to disable.
# HUNTSMAN_RAW_ARCHIVE=1

# Where raw provider payloads are archived, when the above is enabled
# Default: an app-private data directory
# HUNTSMAN_RAW_ARCHIVE_DIR=/path/to/archive

# Global fallback webhook URL, used when a scan doesn't specify its own
# HUNTSMAN_WEBHOOK_URL=https://example.com/hse-webhook

# OathNet API base URL override (self-hosting, an alternate mirror, testing)
# HUNTSMAN_OATHNET_BASE=https://oathnet.org/api

# OathNet per-scan credit cap (default: from plan config, typically 4) and
# per-session cap (fixed default: 30, to protect the daily allowance from a
# long radar/live session) — same override pattern as HUNTSMAN_SEEKNOW_SCAN_CAP
# above
# HUNTSMAN_OATHNET_SCAN_CAP=4
# HUNTSMAN_OATHNET_SESSION_CAP=30

# SeekNow per-session credit budget cap (sibling of HUNTSMAN_SEEKNOW_SCAN_CAP
# above, which caps per-scan instead). Default: 100000 (set high; the
# server's own quota is the real backstop)
# HUNTSMAN_SEEKNOW_SESSION_CAP=100000

# Per-service WiGLE credit budget caps (scan/session), one pair per WiGLE
# lookup kind — defaults differ per kind (shown below), reflecting each
# lookup's real cost. Same override pattern as the SeekNow/OathNet caps
# above; all ten are optional.
# HUNTSMAN_WIGLE_BSSID_SCAN_CAP=5
# HUNTSMAN_WIGLE_BSSID_SESSION_CAP=100
# HUNTSMAN_WIGLE_BT_SCAN_CAP=2
# HUNTSMAN_WIGLE_BT_SESSION_CAP=30
# HUNTSMAN_WIGLE_CELL_SCAN_CAP=2
# HUNTSMAN_WIGLE_CELL_SESSION_CAP=30
# HUNTSMAN_WIGLE_GEO_SCAN_CAP=3
# HUNTSMAN_WIGLE_GEO_SESSION_CAP=50
# HUNTSMAN_WIGLE_SSID_SCAN_CAP=3
# HUNTSMAN_WIGLE_SSID_SESSION_CAP=40

# ============================================================================
# AI-DAEMON SCAN ANALYSIS (opt-in — see README's "AI-Daemon Scan Analysis"
# section; arm with `hse config feature.ai_daemon on` before these apply)
# ============================================================================

# Base URL of a locally running Ollama server
# Default: http://127.0.0.1:11434
# HUNTSMAN_OLLAMA_URL=http://127.0.0.1:11434

# Ollama model tag to use for scan analysis (e.g. a tag already pulled via
# `ollama pull qwen2.5:7b`). No default — hse analyze/hse-ai-daemon refuse to
# guess a model and hard-fail without one, to avoid silently invoking
# whatever an operator happens to have pulled.
# HUNTSMAN_OLLAMA_MODEL=qwen2.5:7b

# Per-request generation timeout in milliseconds (floor: 1000)
# Default: 120000
# HUNTSMAN_OLLAMA_TIMEOUT_MS=120000

# hse-ai-daemon only: seconds between polls for scans pending analysis (floor: 15)
# Default: 60
# HUNTSMAN_AI_POLL_INTERVAL_SECS=60

# ============================================================================
# OPTIONAL: ADDITIONAL CONFIGURATION
# ============================================================================

# Enable debug logging (values: debug, info, warn, error)
# RUST_LOG=debug

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================
#
# 1. Copy this file to your home directory:
#    cp .env.example ~/.huntsman.env
#
# 2. Edit ~/.huntsman.env and add your API keys:
#    nano ~/.huntsman.env
#
# 3. Source the file to load the environment (HSE loads it automatically):
#    source ~/.huntsman.env
#
# 4. Verify your setup:
#    hse doctor
#
# 5. Run a test scan:
#    hse scan --kind email --value test@example.com --depth 1
#
# ============================================================================
# SECURITY NOTES
# ============================================================================
#
# - ~/.huntsman.env is read-only to the user (mode 0600) — never commit it
# - API keys are NEVER logged to console or saved to scan results
# - All requests are made over HTTPS with TLS verification
# - Keys are stored in-process only, never written to disk except ~/.huntsman.env
# - Each module receives only its own API key (no cross-module key exposure)
#
# ============================================================================
