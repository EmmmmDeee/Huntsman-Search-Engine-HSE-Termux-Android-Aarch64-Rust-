target/

# Repository snapshots must be extracted into reviewable source trees instead of
# committed as opaque root-level archive containers.
/*.zip
/*.7z
/*.rar
/*.tar
/*.tar.gz
/*.tgz
/*.tar.bz2
/*.tar.xz
/*.tar.zst

# Python bytecode is written when the dual-pass runner and its helpers run locally.
# It is generated output and must never be committed.
__pycache__/
*.pyc

# Local agent worktrees that the automation creates under .claude/. They are checkouts of
# other commits, and they must never be committed to this repository.
/.claude/

# Per-run outputs of the dual-pass and issue-fix automation and of the release key scan. They are
# evidence for one run, not source, and must never be committed.
/dual-pass-out/
/dual-pass-report.md
/execution-plan.json
/.issue-body.md
/.dual-pass-*
key-scan-report.txt
/dist/
/*.log
