target/

# Repository snapshots must be extracted into reviewable source trees instead of
# committed as opaque root-level archive containers.
/*.zip
/*.7z
/*.rar
/*.tar
/*.tar.gz
/*.tgz
/*.tar.bz2
/*.tar.xz
/*.tar.zst

# Python bytecode is written when the dual-pass runner and its helpers run locally.
# It is generated output and must never be committed.
__pycache__/
*.pyc
