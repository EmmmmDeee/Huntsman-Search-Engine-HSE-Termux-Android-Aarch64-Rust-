+fn canonical_breach_corpus(raw: &str) -> String {
+    let mut out = String::with_capacity(raw.len());
+    for part in raw.split_whitespace() {
+        if !out.is_empty() {
+            out.push(' ');
+        }
+        out.extend(part.chars().map(|ch| ch.to_ascii_lowercase()));
+    }
+    out
+}
