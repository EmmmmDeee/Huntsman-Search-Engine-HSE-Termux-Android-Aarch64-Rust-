+#[cfg(test)]
+mod tests {
+    use super::project_scan;
+    use crate::core::correlator::{Correlation, Severity};
+    use crate::core::entity::{Entity, EntityKind, Evidence};
+    use crate::core::intelligence::ClaimState;
+
+    fn entity(value: &str, source: &str) -> Entity {
+        let mut entity = Entity::new(EntityKind::Username, value, 0.9, "scan-1");
+        entity.add_evidence(Evidence::new(source, format!("{source} observed {value}")));
+        entity
+    }
+
+    fn correlation(a: &Entity, b: &Entity) -> Correlation {
+        Correlation {
+            rule_id: "TEST-001".to_string(),
+            rule_name: "test relationship".to_string(),
+            severity: Severity::High,
+            description: "test relationship fired".to_string(),
+            entity_uids: vec![a.uid.clone(), b.uid.clone()],
+            scan_id: "scan-1".to_string(),
+            ts: 1_700_000_000,
+            rank: 2.7,
+        }
+    }
+
+    fn observed_entity_claim<'a>(
+        projection: &'a super::IntelligenceProjection,
+        uid: &str,
+    ) -> &'a crate::core::intelligence::Claim {
+        projection
+            .ledger
+            .claims
+            .values()
+            .find(|claim| claim.subject_entity_uid == uid && claim.predicate == "observed_entity")
+            .expect("entity observation claim should exist")
+    }
+
+    #[test]
+    fn same_source_is_one_witness_and_does_not_promote_entity_claim() {
+        let mut a = entity("alpha", "same_corpus");
+        a.add_evidence(Evidence::new("same_corpus", "second observation"));
+        let projection = project_scan(std::slice::from_ref(&a), &[])
+            .expect("projection should succeed");
+        let claim = observed_entity_claim(&projection, &a.uid);
+        assert_eq!(claim.state, ClaimState::Candidate);
+        assert_eq!(
+            projection
+                .ledger
+                .independent_source_count(&claim.supporting_evidence),
+            1
+        );
+    }
+
+    #[test]
+    fn independent_sources_promote_entity_claim_to_supported() {
+        let mut a = entity("alpha", "provider_a");
+        a.add_evidence(Evidence::new("provider_b", "independent observation"));
+        let projection = project_scan(std::slice::from_ref(&a), &[])
+            .expect("projection should succeed");
+        let claim = observed_entity_claim(&projection, &a.uid);
+        assert_eq!(claim.state, ClaimState::Supported);
+        assert_eq!(
+            projection
+                .ledger
+                .independent_source_count(&claim.supporting_evidence),
+            2
+        );
+    }
+
+    #[test]
+    fn derived_evidence_is_preserved_but_never_used_as_support() {
+        let mut a = Entity::new(EntityKind::Username, "alpha", 0.9, "scan-1");
+        a.add_evidence(Evidence::new("name_intel", "derived alias").with_inferred(true));
+        let projection = project_scan(std::slice::from_ref(&a), &[])
+            .expect("projection should succeed");
+        assert_eq!(projection.projected_evidence_count, 1);
+        let claim = observed_entity_claim(&projection, &a.uid);
+        assert_eq!(claim.state, ClaimState::Candidate);
+        assert!(claim.supporting_evidence.is_empty());
+    }
+
+    #[test]
+    fn shared_origin_metadata_collapses_different_publishers() {
+        let mut a = Entity::new(EntityKind::Username, "alpha", 0.9, "scan-1");
+        a.add_evidence(
+            Evidence::new("provider_a", "republished record")
+                .with_attr("publisher_id", "publisher-a")
+                .with_attr("origin_id", "record-42"),
+        );
+        a.add_evidence(
+            Evidence::new("provider_b", "same underlying record")
+                .with_attr("publisher_id", "publisher-b")
+                .with_attr("origin_id", "record-42"),
+        );
+        let projection = project_scan(std::slice::from_ref(&a), &[])
+            .expect("projection should succeed");
+        let claim = observed_entity_claim(&projection, &a.uid);
+        assert_eq!(claim.state, ClaimState::Candidate);
+        assert_eq!(
+            projection
+                .ledger
+                .independent_source_count(&claim.supporting_evidence),
+            1
+        );
+    }
+
+    #[test]
+    fn correlation_becomes_inference_and_never_self_promotes_relationship() {
+        let mut a = entity("alpha", "provider_a");
+        a.add_evidence(Evidence::new("provider_b", "second source for alpha"));
+        let mut b = entity("bravo", "provider_c");
+        b.add_evidence(Evidence::new("provider_d", "second source for bravo"));
+        let projection = project_scan(&[a.clone(), b.clone()], &[correlation(&a, &b)])
+            .expect("projection should succeed");
+        assert_eq!(projection.projected_inference_count, 1);
+        let relationship = projection
+            .ledger
+            .claims
+            .values()
+            .find(|claim| claim.predicate == "correlation:TEST-001")
+            .expect("relationship claim should exist");
+        assert_eq!(relationship.state, ClaimState::Candidate);
+        assert!(relationship.supporting_evidence.is_empty());
+        assert_eq!(relationship.inference_ids.len(), 1);
+    }
+
+    #[test]
+    fn missing_correlation_endpoint_is_reported_not_partially_inferred() {
+        let a = entity("alpha", "provider_a");
+        let ghost = Entity::new(EntityKind::Username, "ghost", 0.9, "scan-1");
+        let corr = correlation(&a, &ghost);
+        let projection = project_scan(std::slice::from_ref(&a), &[corr])
+            .expect("projection should succeed while preserving the coverage gap");
+        assert_eq!(projection.unprojected_correlation_count, 1);
+        assert_eq!(projection.projected_relationship_claim_count, 0);
+        assert_eq!(projection.projected_inference_count, 0);
+    }
+
+    #[test]
+    fn content_digest_is_not_invented_from_extracted_summary() {
+        let a = entity("alpha", "provider_a");
+        let projection = project_scan(std::slice::from_ref(&a), &[])
+            .expect("projection should succeed");
+        let record = projection
+            .ledger
+            .evidence
+            .values()
+            .next()
+            .expect("evidence should exist");
+        assert!(record.lineage.content_digest.is_none());
+    }
+
+    #[test]
+    fn projection_is_deterministic_for_identical_inputs() {
+        let a = entity("alpha", "provider_a");
+        let b = entity("bravo", "provider_b");
+        let corr = correlation(&a, &b);
+        let first = project_scan(&[a.clone(), b.clone()], std::slice::from_ref(&corr))
+            .expect("first projection should succeed");
+        let second = project_scan(&[a, b], &[corr]).expect("second projection should succeed");
+        assert_eq!(
+            first.ledger.evidence.keys().collect::<Vec<_>>(),
+            second.ledger.evidence.keys().collect::<Vec<_>>()
+        );
+        assert_eq!(
+            first.ledger.claims.keys().collect::<Vec<_>>(),
+            second.ledger.claims.keys().collect::<Vec<_>>()
+        );
+        assert_eq!(
+            first.ledger.inferences.keys().collect::<Vec<_>>(),
+            second.ledger.inferences.keys().collect::<Vec<_>>()
+        );
+    }
+}
