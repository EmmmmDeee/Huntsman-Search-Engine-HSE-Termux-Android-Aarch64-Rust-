+//! Read-only projection of persisted scan state into the staged intelligence ledger.
+//!
+//! `core::intelligence` deliberately keeps evidence, claims, inferences, and
+//! hypotheses separate, but the live scan engine still promotes entities with
+//! `Entity::confidence`. This module activates the stronger epistemic model
+//! without changing those promotion semantics: it deterministically projects
+//! already-persisted entities and correlations into an [`IntelligenceLedger`].
+//!
+//! The projection is intentionally conservative:
+//! - raw `Entity::evidence` remains authoritative and is never mutated;
+//! - inferred, enrichment-only, and engine-corroboration records are preserved
+//!   in the ledger but never used as independent support for an observation claim;
+//! - lineage metadata is consumed when a module provides it, otherwise one
+//!   module/source is treated as one reporting family;
+//! - persisted entities become evidence-backed observation claims;
+//! - correlations become *inferences* whose relationship claim remains a
+//!   candidate until direct evidence supports that relationship. Endpoint
+//!   evidence proves the endpoints, not automatically the relationship between them.
+
+use std::collections::{BTreeMap, BTreeSet};
+use std::error::Error;
+use std::fmt;
+
+use serde::Serialize;
+use sha2::{Digest, Sha256};
+
+use crate::core::correlator::Correlation;
+use crate::core::entity::{
+    Entity, Evidence, is_engine_corroboration_source, is_non_corroborating_source,
+};
+use crate::core::intelligence::{
+    Claim, ClaimId, ClaimObject, ConfidenceDimensions, EvidenceId, EvidenceNature, EvidenceRecord,
+    Inference, InferenceId, IntelligenceLedger, LedgerError, SourceAuthority, SourceLineage,
+    TemporalValidity,
+};
+
+const MODE: &str = "read_only_projection";
+const LINEAGE_KEYS: &[&str] = &["origin_id", "origin", "corpus", "dataset", "source_record_id"];
+const RETRIEVAL_URI_KEYS: &[&str] = &["retrieval_uri", "source_url", "url"];
+
+/// A stable pointer from projected evidence back to the authoritative entity
+/// evidence slot that produced it. Consumers that need the raw attributes can
+/// retrieve the entity and inspect `evidence_index`; the projection never copies
+/// or rewrites those raw attributes.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct ProjectionEvidenceOrigin {
+    pub evidence_id: EvidenceId,
+    pub entity_uid: String,
+    pub evidence_index: usize,
+}
+
+/// Result of projecting one persisted scan into the staged intelligence model.
+#[derive(Debug, Clone, Serialize)]
+pub struct IntelligenceProjection {
+    /// Explicitly states that this view does not alter scan promotion semantics.
+    pub mode: &'static str,
+    pub source_entity_count: usize,
+    pub source_correlation_count: usize,
+    pub projected_evidence_count: usize,
+    pub projected_entity_claim_count: usize,
+    pub projected_relationship_claim_count: usize,
+    pub projected_inference_count: usize,
+    /// Correlations without entity endpoints cannot be represented honestly as
+    /// entity claims; they are counted rather than silently discarded.
+    pub unprojected_correlation_count: usize,
+    pub evidence_origins: Vec<ProjectionEvidenceOrigin>,
+    pub ledger: IntelligenceLedger,
+}
+
+/// Projection failures are invariant violations in the adapter itself. They do
+/// not indicate that the source scan is bad, and the source records are never
+/// modified when one occurs.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ProjectionError {
+    detail: String,
+}
+
+impl ProjectionError {
+    fn ledger(error: LedgerError) -> Self {
+        Self {
+            detail: format!("intelligence ledger rejected projected state: {error:?}"),
+        }
+    }
+}
+
+impl fmt::Display for ProjectionError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str(&self.detail)
+    }
+}
+
+impl Error for ProjectionError {}
+
+/// Deterministically project persisted entities and correlations into an
+/// [`IntelligenceLedger`] without changing either input.
+///
+/// Entity evidence supports only the entity's observation claim. A correlation
+/// is projected as an inference from those observation claims to a separate
+/// relationship claim. Because an inference is not a witness, the ledger keeps
+/// that relationship claim in `Candidate` until direct evidence is attached by
+/// a future evidence-aware correlation adapter.
+pub fn project_scan(
+    entities: &[Entity],
+    correlations: &[Correlation],
+) -> Result<IntelligenceProjection, ProjectionError> {
+    let mut ledger = IntelligenceLedger::default();
+    let mut observed_evidence_by_entity: BTreeMap<String, BTreeSet<EvidenceId>> = BTreeMap::new();
+    let mut evidence_origins = Vec::new();
+
+    for entity in entities {
+        for (evidence_index, evidence) in entity.evidence.iter().enumerate() {
+            let nature = evidence_nature(evidence);
+            let evidence_id = projected_evidence_id(entity, evidence);
+            let record = evidence_record(entity, evidence, evidence_id.clone(), nature);
+
+            let stored_id = if ledger.evidence.contains_key(&evidence_id) {
+                evidence_id
+            } else {
+                ledger
+                    .insert_evidence(record)
+                    .map_err(ProjectionError::ledger)?
+            };
+
+            evidence_origins.push(ProjectionEvidenceOrigin {
+                evidence_id: stored_id.clone(),
+                entity_uid: entity.uid.clone(),
+                evidence_index,
+            });
+
+            if nature == EvidenceNature::Observed {
+                observed_evidence_by_entity
+                    .entry(entity.uid.clone())
+                    .or_default()
+                    .insert(stored_id);
+            }
+        }
+    }
+
+    let mut entity_claims = BTreeMap::new();
+    for entity in entities {
+        let claim_id = projected_entity_claim_id(entity);
+        let confidence = entity.c_effective();
+        let mut claim = Claim::new(
+            claim_id.clone(),
+            entity.uid.clone(),
+            "observed_entity",
+            ClaimObject::Literal(format!("{}:{}", entity.kind, entity.value)),
+            ConfidenceDimensions {
+                exploration: confidence,
+                entity_resolution: confidence,
+                geolocation: None,
+                relationship: 0.0,
+                conclusion: confidence,
+            },
+        );
+        claim.temporal = TemporalValidity {
+            valid_from_unix: None,
+            valid_until_unix: None,
+            observed_at_unix: Some(entity.observed_at),
+        };
+        claim.alternative_explanations = vec![
+            "The observation may describe a different entity that shares the same normalized identifier."
+                .to_string(),
+        ];
+        claim.strengthening_conditions = vec![
+            "Obtain an additional independent source lineage that observes the same entity."
+                .to_string(),
+        ];
+        claim.weakening_conditions = vec![
+            "Show that apparently separate observations descend from the same underlying source or resolve to a different entity."
+                .to_string(),
+        ];
+        claim.falsification_conditions = vec![
+            "Invalidate the directly observed source records supporting this entity or show that they resolve to a different entity."
+                .to_string(),
+        ];
+        ledger
+            .insert_claim(claim)
+            .map_err(ProjectionError::ledger)?;
+        if let Some(ids) = observed_evidence_by_entity.get(&entity.uid) {
+            for evidence_id in ids {
+                ledger
+                    .attach_support(&claim_id, evidence_id)
+                    .map_err(ProjectionError::ledger)?;
+            }
+        }
+        entity_claims.insert(entity.uid.clone(), claim_id);
+    }
+
+    let effective_confidence: BTreeMap<&str, f64> = entities
+        .iter()
+        .map(|entity| (entity.uid.as_str(), entity.c_effective()))
+        .collect();
+
+    let mut unprojected_correlation_count = 0;
+    let mut relationship_claim_count = 0;
+    let mut inference_count = 0;
+    for correlation in correlations {
+        let Some(subject_uid) = correlation
+            .entity_uids
+            .iter()
+            .find(|uid| !uid.trim().is_empty())
+            .cloned()
+        else {
+            unprojected_correlation_count += 1;
+            continue;
+        };
+        let mut entity_uids: Vec<String> = correlation
+            .entity_uids
+            .iter()
+            .filter(|uid| !uid.trim().is_empty())
+            .cloned()
+            .collect();
+        entity_uids.sort();
+        entity_uids.dedup();
+
+        // A relationship whose persisted endpoints are incomplete cannot be
+        // represented faithfully. Record the coverage gap instead of building a
+        // partial inference whose missing premise might be mistaken for absence.
+        if entity_uids.is_empty()
+            || entity_uids
+                .iter()
+                .any(|uid| !entity_claims.contains_key(uid))
+        {
+            unprojected_correlation_count += 1;
+            continue;
+        }
+
+        let conclusion_confidence = entity_uids
+            .iter()
+            .filter_map(|uid| effective_confidence.get(uid.as_str()).copied())
+            .reduce(f64::min)
+            .unwrap_or(0.0);
+        let exploration_confidence = if correlation.rank.is_finite() && correlation.rank > 0.0 {
+            (correlation.rank / 4.0).clamp(0.0, 1.0)
+        } else {
+            conclusion_confidence
+        };
+
+        let claim_id = projected_relationship_claim_id(correlation, &entity_uids);
+        let object = if entity_uids.len() == 2 {
+            let other_uid = entity_uids
+                .iter()
+                .find(|uid| uid.as_str() != subject_uid.as_str())
+                .cloned()
+                .unwrap_or_else(|| entity_uids[0].clone());
+            ClaimObject::EntityUid(other_uid)
+        } else {
+            ClaimObject::Literal(correlation.description.clone())
+        };
+        let mut claim = Claim::new(
+            claim_id.clone(),
+            subject_uid,
+            format!("correlation:{}", correlation.rule_id),
+            object,
+            ConfidenceDimensions {
+                exploration: exploration_confidence,
+                entity_resolution: conclusion_confidence,
+                geolocation: None,
+                relationship: conclusion_confidence,
+                conclusion: conclusion_confidence,
+            },
+        );
+        claim.temporal = TemporalValidity {
+            valid_from_unix: None,
+            valid_until_unix: None,
+            observed_at_unix: Some(correlation.ts),
+        };
+        let alternative = "The shared indicators may arise from a common provider, template, dependency, republished dataset, or coincidence rather than a direct relationship.".to_string();
+        claim.alternative_explanations = vec![alternative.clone()];
+        claim.strengthening_conditions = vec![
+            "Attach direct, independently sourced evidence for the asserted relationship rather than relying on endpoint evidence alone."
+                .to_string(),
+        ];
+        claim.weakening_conditions = vec![
+            "Show that the correlation is explained by a common third-party dependency, common dataset, or non-independent source lineage."
+                .to_string(),
+        ];
+        let rule_falsifier = format!(
+            "Re-running correlation rule {} over the same persisted state no longer produces this relationship.",
+            correlation.rule_id
+        );
+        claim.falsification_conditions = vec![
+            rule_falsifier.clone(),
+            "Invalidate a premise entity observation required by the correlation.".to_string(),
+        ];
+        ledger
+            .insert_claim(claim)
+            .map_err(ProjectionError::ledger)?;
+        relationship_claim_count += 1;
+
+        let premise_claim_ids: BTreeSet<ClaimId> = entity_uids
+            .iter()
+            .filter_map(|uid| entity_claims.get(uid).cloned())
+            .collect();
+        if !premise_claim_ids.is_empty() {
+            let inference = Inference {
+                id: projected_inference_id(correlation, &entity_uids),
+                premise_claim_ids,
+                conclusion_claim_id: claim_id,
+                method: format!("correlator:{}", correlation.rule_id),
+                confidence: conclusion_confidence,
+                alternative_explanations: vec![alternative],
+                falsification_conditions: vec![rule_falsifier],
+            };
+            ledger
+                .insert_inference(inference)
+                .map_err(ProjectionError::ledger)?;
+            inference_count += 1;
+        }
+    }
+
+    Ok(IntelligenceProjection {
+        mode: MODE,
+        source_entity_count: entities.len(),
+        source_correlation_count: correlations.len(),
+        projected_evidence_count: ledger.evidence.len(),
+        projected_entity_claim_count: entity_claims.len(),
+        projected_relationship_claim_count: relationship_claim_count,
+        projected_inference_count: inference_count,
+        unprojected_correlation_count,
+        evidence_origins,
+        ledger,
+    })
+}
+
+fn evidence_nature(evidence: &Evidence) -> EvidenceNature {
+    if evidence.is_inferred
+        || is_non_corroborating_source(&evidence.source)
+        || is_engine_corroboration_source(&evidence.source)
+    {
+        EvidenceNature::Derived
+    } else {
+        EvidenceNature::Observed
+    }
+}
+
+fn evidence_record(
+    entity: &Entity,
+    evidence: &Evidence,
+    id: EvidenceId,
+    nature: EvidenceNature,
+) -> EvidenceRecord {
+    let projection_digest = evidence_content_digest(evidence);
+    let source_id = first_attr(evidence, &["source_id", "record_id"]).unwrap_or_else(|| {
+        format!("{}:{}", evidence.source, &projection_digest[..16])
+    });
+    let publisher_id =
+        first_attr(evidence, &["publisher_id"]).unwrap_or_else(|| evidence.source.clone());
+    let mut origin_ids = BTreeSet::new();
+    for key in LINEAGE_KEYS {
+        for value in evidence.attr_values(key) {
+            origin_ids.insert(format!("{key}:{value}"));
+        }
+    }
+    if origin_ids.is_empty() {
+        origin_ids.insert(format!("source:{}", evidence.source));
+    }
+
+    EvidenceRecord {
+        id,
+        nature,
+        summary: evidence.summary.clone(),
+        // Existing module evidence has no uniform source-authority field.
+        // Guessing here would manufacture precision, so the projection stays
+        // Unknown until a source-specific adapter can state authority honestly.
+        authority: SourceAuthority::Unknown,
+        source_confidence: entity.confidence,
+        lineage: SourceLineage {
+            source_id,
+            publisher_id,
+            origin_ids,
+            retrieval_uri: first_attr(evidence, RETRIEVAL_URI_KEYS),
+            // Only preserve a content digest when the source actually supplied
+            // one. Hashing an extracted summary and calling it the retrieved
+            // document digest would manufacture provenance precision.
+            content_digest: first_attr(evidence, &["content_digest", "source_digest", "sha256"]),
+        },
+        temporal: TemporalValidity {
+            valid_from_unix: None,
+            valid_until_unix: None,
+            observed_at_unix: Some(evidence.recorded_at),
+        },
+        jurisdiction: first_attr(evidence, &["jurisdiction"]),
+        location: None,
+    }
+}
+
+fn first_attr(evidence: &Evidence, keys: &[&str]) -> Option<String> {
+    for key in keys {
+        if let Some(value) = evidence.attr_values(key).next() {
+            return Some(value.to_string());
+        }
+    }
+    None
+}
+
+fn projected_evidence_id(entity: &Entity, evidence: &Evidence) -> EvidenceId {
+    let mut hasher = Sha256::new();
+    hash_part(&mut hasher, "evidence");
+    hash_part(&mut hasher, &entity.uid);
+    hash_part(&mut hasher, &evidence.source);
+    hash_part(&mut hasher, &evidence_content_digest(evidence));
+    hash_part(&mut hasher, &evidence.recorded_at.to_string());
+    hash_part(&mut hasher, &evidence.scan_id);
+    EvidenceId(format!("ev:{}", hex::encode(hasher.finalize())))
+}
+
+fn evidence_content_digest(evidence: &Evidence) -> String {
+    let mut hasher = Sha256::new();
+    hash_part(&mut hasher, &evidence.summary);
+    hash_part(&mut hasher, if evidence.is_inferred { "1" } else { "0" });
+    if let Some(verification) = &evidence.verification {
+        hash_part(&mut hasher, &format!("{verification:?}"));
+    }
+    for (key, value) in &evidence.attributes {
+        hash_part(&mut hasher, key);
+        hash_part(&mut hasher, value);
+    }
+    hex::encode(hasher.finalize())
+}
+
+fn projected_entity_claim_id(entity: &Entity) -> ClaimId {
+    let mut hasher = Sha256::new();
+    hash_part(&mut hasher, "entity-observation");
+    hash_part(&mut hasher, &entity.scan_id);
+    hash_part(&mut hasher, &entity.uid);
+    ClaimId(format!("claim:{}", hex::encode(hasher.finalize())))
+}
+
+fn projected_relationship_claim_id(correlation: &Correlation, entity_uids: &[String]) -> ClaimId {
+    ClaimId(format!(
+        "claim:{}",
+        correlation_digest("relationship", correlation, entity_uids)
+    ))
+}
+
+fn projected_inference_id(correlation: &Correlation, entity_uids: &[String]) -> InferenceId {
+    InferenceId(format!(
+        "inference:{}",
+        correlation_digest("inference", correlation, entity_uids)
+    ))
+}
+
+fn correlation_digest(kind: &str, correlation: &Correlation, entity_uids: &[String]) -> String {
+    let mut hasher = Sha256::new();
+    hash_part(&mut hasher, kind);
+    hash_part(&mut hasher, &correlation.scan_id);
+    hash_part(&mut hasher, &correlation.rule_id);
+    hash_part(&mut hasher, &correlation.description);
+    hash_part(&mut hasher, &correlation.ts.to_string());
+    for uid in entity_uids {
+        hash_part(&mut hasher, uid);
+    }
+    hex::encode(hasher.finalize())
+}
+
+fn hash_part(hasher: &mut Sha256, value: &str) {
+    hasher.update((value.len() as u64).to_be_bytes());
+    hasher.update(value.as_bytes());
+}
