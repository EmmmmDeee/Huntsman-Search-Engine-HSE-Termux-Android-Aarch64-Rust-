+++ b/src/api/scan_handlers/intelligence.rs
@@ -0,0 +1,133 @@
+//! Read-only HTTP projection of persisted scan state into the staged
+//! evidence/claim/inference ledger.
+
+use std::collections::HashSet;
+use std::sync::Arc;
+
+use axum::{
+    Json,
+    extract::{Path, Query, State},
+    http::StatusCode,
+    response::IntoResponse,
+};
+use serde_json::json;
+
+use crate::api::AppState;
+
+const DEFAULT_MAX_ENTITIES: usize = 1_000;
+const HARD_MAX_ENTITIES: usize = 5_000;
+
+/// `GET /api/v1/scans/{id}/intelligence` — project a stored scan into the
+/// staged intelligence ledger without changing the scan's persisted entities,
+/// correlations, or current promotion semantics.
+///
+/// Candidate quarantine matches `/entities`: candidates are hidden by default
+/// and can be explicitly included with `?include_candidates=1`. Correlations
+/// touching a hidden endpoint are removed before projection so their description
+/// cannot route around that quarantine.
+///
+/// The projection is intentionally bounded for the primary Termux target. The
+/// default is 1,000 visible entities and `max_entities` is capped at 5,000. The
+/// response reports exactly how many visible entities/correlations were omitted,
+/// so a bounded response can never masquerade as an exhaustive one.
+pub async fn scan_intelligence(
+    State(s): State<Arc<AppState>>,
+    Path(id): Path<String>,
+    Query(params): Query<std::collections::HashMap<String, String>>,
+) -> impl IntoResponse {
+    if let Some(resp) = super::scan_missing(&s, &id).await {
+        return resp;
+    }
+
+    let max_entities = match params.get("max_entities") {
+        None => DEFAULT_MAX_ENTITIES,
+        Some(raw) => match raw.parse::<usize>() {
+            Ok(0) => {
+                return (
+                    StatusCode::BAD_REQUEST,
+                    Json(json!({"error": "max_entities must be greater than zero"})),
+                )
+                    .into_response();
+            }
+            Ok(value) => value.min(HARD_MAX_ENTITIES),
+            Err(_) => {
+                return (
+                    StatusCode::BAD_REQUEST,
+                    Json(json!({"error": "max_entities must be a positive integer"})),
+                )
+                    .into_response();
+            }
+        },
+    };
+
+    let store = Arc::clone(&s.store);
+    let id2 = id.clone();
+    let (mut entities, mut correlations) = match super::offload_store(move || {
+        Ok((
+            store.entities_for_scan(&id2)?,
+            store.correlations_for_scan(&id2)?,
+        ))
+    })
+    .await
+    {
+        Ok(pair) => pair,
+        Err(resp) => return resp,
+    };
+
+    // Privacy gate first: descriptions on correlations touching hidden
+    // candidates must never leak around the entity quarantine.
+    let gate = super::EntityViewGate::from_params(&params);
+    gate.apply_to_entity_set(&mut entities);
+    let visible_uids: HashSet<&str> = entities.iter().map(|entity| entity.uid.as_str()).collect();
+    correlations.retain(|correlation| {
+        correlation
+            .entity_uids
+            .iter()
+            .all(|uid| visible_uids.contains(uid.as_str()))
+    });
+
+    let visible_entity_count = entities.len();
+    let visible_correlation_count = correlations.len();
+    if entities.len() > max_entities {
+        entities.truncate(max_entities);
+    }
+    let projected_uids: HashSet<&str> = entities.iter().map(|entity| entity.uid.as_str()).collect();
+    correlations.retain(|correlation| {
+        correlation
+            .entity_uids
+            .iter()
+            .all(|uid| projected_uids.contains(uid.as_str()))
+    });
+    let projected_correlation_count = correlations.len();
+
+    match crate::core::intelligence_projection::project_scan(&entities, &correlations) {
+        Ok(projection) => (
+            StatusCode::OK,
+            Json(json!({
+                "scope": {
+                    "visible_entity_count": visible_entity_count,
+                    "projected_entity_count": entities.len(),
+                    "omitted_entity_count": visible_entity_count.saturating_sub(entities.len()),
+                    "visible_correlation_count": visible_correlation_count,
+                    "projected_correlation_count": projected_correlation_count,
+                    "omitted_correlation_count": visible_correlation_count.saturating_sub(projected_correlation_count),
+                    "max_entities": max_entities,
+                    "hard_max_entities": HARD_MAX_ENTITIES,
+                    "truncated": visible_entity_count > entities.len()
+                        || visible_correlation_count > projected_correlation_count,
+                },
+                "projection": projection,
+            })),
+        )
+            .into_response(),
+        Err(error) => (
+            StatusCode::INTERNAL_SERVER_ERROR,
+            Json(json!({
+                "error": "intelligence projection invariant violation",
+                "detail": error.to_string(),
+                "scan_id": id,
+            })),
+        )
+            .into_response(),
+    }
+}
diff --git a/src/bin/intelligence-audit/main.rs b/src/bin/intelligence-audit/main.rs
new file mode 100644
--- /dev/null
+++ b/src/bin/intelligence-audit/main.rs
@@ -0,0 +1,115 @@
+//! Project a real persisted HSE scan into the staged intelligence ledger.
+//!
+//! This is deliberately read-only: it exercises `core::intelligence` against
+//! production scan state without changing entity promotion or the SQLite schema.
+
+use std::collections::HashSet;
+use std::error::Error;
+use std::io::{self, Write};
+
+use clap::Parser;
+use huntsman_search_engine::core::intelligence_projection::project_scan;
+use huntsman_search_engine::core::port::StoragePort;
+use huntsman_search_engine::default_db_path;
+use huntsman_search_engine::storage::Store;
+use serde::Serialize;
+
+const DEFAULT_MAX_ENTITIES: usize = 5_000;
+const HARD_MAX_ENTITIES: usize = 100_000;
+
+#[derive(Debug, Parser)]
+#[command(
+    name = "intelligence-audit",
+    about = "Project a persisted HSE scan into the staged evidence/claim ledger"
+)]
+struct Args {
+    /// Scan id to project. Omit or pass `latest` to use the most recent finished scan.
+    #[arg(default_value = "latest")]
+    scan_id: String,
+
+    /// SQLite database path. Defaults to HSE's normal on-device database.
+    #[arg(long)]
+    db: Option<String>,
+
+    /// Maximum entities to project. Bounded so an imported bulk dossier cannot
+    /// accidentally duplicate its complete evidence graph in memory.
+    #[arg(long, default_value_t = DEFAULT_MAX_ENTITIES)]
+    max_entities: usize,
+
+    /// Emit compact JSON instead of pretty-printed JSON.
+    #[arg(long)]
+    compact: bool,
+}
+
+#[derive(Serialize)]
+struct AuditOutput {
+    scan_id: String,
+    total_entity_count: usize,
+    projected_entity_count: usize,
+    total_correlation_count: usize,
+    projected_correlation_count: usize,
+    truncated: bool,
+    projection: huntsman_search_engine::core::intelligence_projection::IntelligenceProjection,
+}
+
+fn main() -> Result<(), Box<dyn Error>> {
+    let args = Args::parse();
+    if !(1..=HARD_MAX_ENTITIES).contains(&args.max_entities) {
+        return Err(format!(
+            "--max-entities must be between 1 and {HARD_MAX_ENTITIES}"
+        )
+        .into());
+    }
+
+    let db = args.db.unwrap_or_else(default_db_path);
+    let store = Store::open(&db)?;
+    let requested_scan_id = args.scan_id;
+    let scan_id = if requested_scan_id == "latest" {
+        store
+            .latest_finished_scan()?
+            .ok_or_else(|| format!("no finished scan exists in {db}"))?
+            .id
+    } else {
+        if store.get_scan(&requested_scan_id)?.is_none() {
+            return Err(format!("scan `{requested_scan_id}` does not exist in {db}").into());
+        }
+        requested_scan_id
+    };
+
+    let mut entities = store.entities_for_scan(&scan_id)?;
+    let mut correlations = store.correlations_for_scan(&scan_id)?;
+    let total_entity_count = entities.len();
+    let total_correlation_count = correlations.len();
+    if entities.len() > args.max_entities {
+        entities.truncate(args.max_entities);
+    }
+    let projected_uids: HashSet<&str> = entities.iter().map(|entity| entity.uid.as_str()).collect();
+    correlations.retain(|correlation| {
+        correlation
+            .entity_uids
+            .iter()
+            .all(|uid| projected_uids.contains(uid.as_str()))
+    });
+    let projected_correlation_count = correlations.len();
+    let projection = project_scan(&entities, &correlations)?;
+    let output = AuditOutput {
+        scan_id,
+        total_entity_count,
+        projected_entity_count: entities.len(),
+        total_correlation_count,
+        projected_correlation_count,
+        truncated: total_entity_count > entities.len()
+            || total_correlation_count > projected_correlation_count,
+        projection,
+    };
+
+    let stdout = io::stdout();
+    let mut out = stdout.lock();
+    if args.compact {
+        serde_json::to_writer(&mut out, &output)?;
+    } else {
+        serde_json::to_writer_pretty(&mut out, &output)?;
+    }
+    writeln!(out)?;
+    Ok(())
+}
