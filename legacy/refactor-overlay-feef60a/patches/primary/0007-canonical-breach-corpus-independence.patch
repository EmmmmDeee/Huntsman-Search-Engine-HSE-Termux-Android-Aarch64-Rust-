+#[test]
+fn au105_does_not_infer_reuse_from_formatting_variants_of_one_corpus() {
+    let secret = "HSE-regression-unique-secret-2026";
+    let mut entity = Entity::new(EntityKind::Email, "self@example.test", 0.9, "s");
+    entity.add_evidence(
+        Evidence::new("oathnet_pro", "hit")
+            .with_attr("dbname", "Adobe 2013")
+            .with_attr("password", secret),
+    );
+    entity.add_evidence(
+        Evidence::new("see_know", "hit")
+            .with_attr("source_db", "  ADOBE   2013 ")
+            .with_attr("password", secret),
+    );
+    let out =
+        super::rules::rule_au_105_credential_reuse(&RuleContext::new(&[entity]), "s", 0);
+    assert!(
+        out.is_empty(),
+        "one corpus observed through two provider/formatting paths is not credential reuse"
+    );
+}
