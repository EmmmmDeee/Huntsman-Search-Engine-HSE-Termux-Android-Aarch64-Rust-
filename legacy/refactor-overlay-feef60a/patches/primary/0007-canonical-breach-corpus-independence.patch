 #[test]
+fn breach_corpus_key_is_conservative_canonical_and_blank_safe() {
+    let a = Evidence::new("oathnet_pro", "hit").with_attr("dbname", "  Adobe   2013 ");
+    let b = Evidence::new("see_know", "hit").with_attr("source_db", "ADOBE 2013");
+    assert_eq!(super::breach_corpus_key(&a), "adobe 2013");
+    assert_eq!(super::breach_corpus_key(&a), super::breach_corpus_key(&b));
+
+    let c = Evidence::new("leakcheck", "hit")
+        .with_attr("dbname", "   ")
+        .with_attr("breach", " LinkedIn ");
+    assert_eq!(super::breach_corpus_key(&c), "linkedin");
+
+    let d = Evidence::new("OATHNET_PRO", "hit")
+        .with_attr("dbname", "\t ")
+        .with_attr("source_db", "");
+    assert_eq!(super::breach_corpus_key(&d), "oathnet_pro");
+
+    let e = Evidence::new("oathnet_pro", "hit").with_attr("dbname", "Adobe 2014");
+    assert_ne!(super::breach_corpus_key(&a), super::breach_corpus_key(&e));
+}
