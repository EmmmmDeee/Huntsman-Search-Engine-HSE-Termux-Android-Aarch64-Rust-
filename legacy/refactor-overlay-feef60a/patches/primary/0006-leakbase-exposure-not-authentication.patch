 #[test]
+fn leakbase_html_preserves_exposure_pivots_but_never_secret_entities() {
+    use crate::core::entity::EntityKind;
+
+    let body = r#"<!DOCTYPE html>
+<html>
+<head><title>LeakBase</title></head>
+<body>
+<div class="nav-title">Table of Contents</div>
+<div class="block-title">Example breach</div>
+contact: analyst@example.com
+site: example.com
+host: 203.0.113.77
+Password: CorrectHorseBatteryStaple!
+api_key: sk-test-abcdefghijklmnopqrstuvwxyz012345
+</body>
+</html>"#;
+
+    let entities = parse_oathnet_html(body, "leakbase-test");
+
+    assert!(
+        entities
+            .iter()
+            .any(|entity| entity.kind == EntityKind::Email && entity.value == "analyst@example.com"),
+        "LeakBase import must preserve non-secret exposure pivots"
+    );
+    assert!(
+        !entities.iter().any(|entity| {
+            matches!(
+                entity.kind,
+                EntityKind::Password | EntityKind::Credential | EntityKind::ApiKey
+            )
+        }),
+        "LeakBase HTML must never become a secret/authentication-material ingress path"
+    );
+    for entity in &entities {
+        assert!(
+            entity.tags.iter().any(|tag| tag == "source:leakbase")
+                && entity.tags.iter().any(|tag| tag == "exposure-evidence"),
+            "LeakBase-derived entities must retain explicit provenance"
+        );
+    }
+}
