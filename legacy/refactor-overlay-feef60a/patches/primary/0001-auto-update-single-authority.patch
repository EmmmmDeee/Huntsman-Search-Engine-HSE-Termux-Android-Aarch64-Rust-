+/// Commands that own installation state or only observe the current install.
+///
+/// This is the single executable authority used by runtime dispatch and tests;
+/// there is deliberately no mirrored test predicate to keep in sync.
+fn skips_auto_update(command: &Command) -> bool {
+    matches!(
+        command,
+        Command::Serve { .. }
+            | Command::Update { .. }
+            | Command::BuildSha { .. }
+            | Command::Doctor { .. }
+            | Command::Selftest { .. }
+            | Command::Provision { .. }
+    )
+}
 
