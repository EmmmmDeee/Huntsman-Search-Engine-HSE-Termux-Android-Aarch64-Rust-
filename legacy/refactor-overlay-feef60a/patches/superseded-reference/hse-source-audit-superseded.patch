+//! `source-audit` — deterministic evidence-first source contradiction scanner.
+//!
+//! The tool is development/CI tooling, not part of HSE's OSINT runtime. It emits
+//! candidate hypotheses with source evidence plus explicit verification and
+//! falsification instructions; it never labels a heuristic match a vulnerability.
+
+mod audit;
+
+use std::path::PathBuf;
+use std::process::ExitCode;
+
+use clap::Parser;
+
+#[derive(Parser)]
+#[command(
+    name = "source-audit",
+    about = "Find evidence-backed source-code contradiction candidates without promoting heuristics to vulnerabilities"
+)]
+struct Args {
+    /// File or directory to scan. Directories are traversed deterministically.
+    #[arg(default_value = ".")]
+    path: PathBuf,
+    /// Emit machine-readable JSON instead of the human report.
+    #[arg(long)]
+    json: bool,
+    /// Also write the rendered report to this path.
+    #[arg(long)]
+    out: Option<PathBuf>,
+    /// Maximum source-file size accepted for analysis.
+    #[arg(long, default_value_t = 2 * 1024 * 1024)]
+    max_file_bytes: u64,
+    /// Context lines retained on each side of the triggering evidence span.
+    #[arg(long, default_value_t = 4)]
+    context_lines: usize,
+    /// Exit 1 when any candidate is emitted. Off by default because candidates
+    /// require falsification/verification before they can gate a build.
+    #[arg(long)]
+    fail_on_findings: bool,
+}
+
+fn main() -> ExitCode {
+    let args = Args::parse();
+    let report = match audit::scan_path(
+        &args.path,
+        audit::AuditConfig {
+            max_file_bytes: args.max_file_bytes,
+            context_lines: args.context_lines,
+        },
+    ) {
+        Ok(report) => report,
+        Err(error) => {
+            eprintln!("source-audit: {}: {error}", args.path.display());
+            return ExitCode::from(2);
+        }
+    };
+
+    let rendered = if args.json {
+        match audit::render_json(&report) {
+            Ok(rendered) => rendered,
+            Err(error) => {
+                eprintln!("source-audit: serializing report: {error}");
+                return ExitCode::from(2);
+            }
+        }
+    } else {
+        audit::render_text(&report)
+    };
+    println!("{rendered}");
+
+    if let Some(out) = &args.out
+        && let Err(error) = std::fs::write(out, format!("{rendered}\n"))
+    {
+        eprintln!("source-audit: writing {}: {error}", out.display());
+        return ExitCode::from(2);
+    }
+
+    if args.fail_on_findings && !report.findings.is_empty() {
+        ExitCode::FAILURE
+    } else {
+        ExitCode::SUCCESS
+    }
+}
