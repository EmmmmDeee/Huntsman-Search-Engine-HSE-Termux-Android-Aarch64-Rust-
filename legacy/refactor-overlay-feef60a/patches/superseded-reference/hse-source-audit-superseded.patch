+        let _ = fs::remove_dir_all(&root);
+        fs::create_dir_all(root.join("target")).expect("mkdir target");
+        fs::create_dir_all(root.join("vendor")).expect("mkdir vendor");
+        fs::write(root.join("target/noise.rs"), "if elapsed_ns > timeout_ms { }\n").expect("write");
+        fs::write(root.join("vendor/noise.c"), "/* `p` may be NULL */\n*p = 1;\n").expect("write");
+        fs::write(root.join("live.rs"), "let ok = true;\n").expect("write");
+        let report = scan_path(&root, AuditConfig::default()).expect("scan");
+        assert_eq!(report.scanned_files, 1);
+        assert!(report.findings.is_empty());
+        fs::remove_dir_all(root).expect("cleanup");
+    }
+
+    #[test]
+    fn json_output_escapes_evidence_and_never_promotes_candidate_to_fact() {
+        let mut report = AuditReport {
+            schema_version: SCHEMA_VERSION,
+            root: ".".to_string(),
+            snapshot: SnapshotState::default(),
+            scanned_files: 1,
+            skipped_files: 0,
+            bytes_scanned: 1,
+            findings: findings("// Remove \"quoted\" flag\nflags ^= bit;\n"),
+            diagnostics: vec![],
+        };
+        report.findings[0].summary.push('\n');
+        let json = render_json(&report).expect("json");
+        assert!(json.contains("\\\"quoted\\\""));
+        assert!(json.contains("\"state\": \"candidate\""));
+        assert!(!json.contains("\"state\": \"verified\""));
+    }
