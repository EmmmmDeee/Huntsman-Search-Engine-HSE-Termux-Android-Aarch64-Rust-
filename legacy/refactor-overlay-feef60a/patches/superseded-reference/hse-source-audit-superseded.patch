+//! Deterministic source-evidence scanner used by the `source-audit` development binary.
+//!
+//! This is intentionally not an "AI verdict" engine. Rules emit *candidate
+//! contradictions* with the exact source span that triggered them plus explicit
+//! verification and falsification instructions. A candidate is never promoted to
+//! a vulnerability merely because a heuristic matched.
+
+use std::collections::{BTreeMap, BTreeSet};
+use std::fs;
+use std::io;
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+use serde::Serialize;
+
+pub const SCHEMA_VERSION: u32 = 1;
+const DEFAULT_MAX_FILE_BYTES: u64 = 2 * 1024 * 1024;
+const DEFAULT_CONTEXT_LINES: usize = 4;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub enum Priority {
+    Medium,
+    High,
+}
+
+impl Priority {
+    pub const fn as_str(self) -> &'static str {
+        match self {
+            Self::Medium => "medium",
+            Self::High => "high",
+        }
+    }
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub enum ContradictionClass {
+    IntentVsImplementation,
+    ContractVsImplementation,
+    UnitConsistency,
+}
+
+impl ContradictionClass {
+    pub const fn as_str(self) -> &'static str {
+        match self {
+            Self::IntentVsImplementation => "intent_vs_implementation",
+            Self::ContractVsImplementation => "contract_vs_implementation",
+            Self::UnitConsistency => "unit_consistency",
+        }
+    }
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub enum FindingState {
+    Candidate,
+}
+
+impl FindingState {
+    pub const fn as_str(self) -> &'static str {
+        match self {
+            Self::Candidate => "candidate",
+        }
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct EvidenceSpan {
+    pub start_line: usize,
+    pub end_line: usize,
+    pub excerpt: String,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct Finding {
+    pub id: String,
+    pub state: FindingState,
+    pub rule_id: &'static str,
+    pub class: ContradictionClass,
+    pub priority: Priority,
+    pub path: String,
+    pub line: usize,
+    pub summary: String,
+    pub rationale: String,
+    pub evidence: EvidenceSpan,
+    pub verification: Vec<String>,
+    pub falsification: Vec<String>,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct Diagnostic {
+    pub path: String,
+    pub message: String,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Default, Serialize)]
+pub struct SnapshotState {
+    pub git_head: Option<String>,
+    pub dirty: Option<bool>,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct AuditReport {
+    pub schema_version: u32,
+    pub root: String,
+    pub snapshot: SnapshotState,
+    pub scanned_files: usize,
+    pub skipped_files: usize,
+    pub bytes_scanned: u64,
+    pub findings: Vec<Finding>,
+    pub diagnostics: Vec<Diagnostic>,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct AuditConfig {
+    pub max_file_bytes: u64,
+    pub context_lines: usize,
+}
+
+impl Default for AuditConfig {
+    fn default() -> Self {
+        Self {
+            max_file_bytes: DEFAULT_MAX_FILE_BYTES,
+            context_lines: DEFAULT_CONTEXT_LINES,
+        }
+    }
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum Language {
+    Rust,
+    CLike,
+}
+
+pub fn scan_path(root: &Path, config: AuditConfig) -> io::Result<AuditReport> {
+    let mut files = Vec::new();
+    collect_source_files(root, &mut files)?;
+    files.sort_by(|a, b| normalized_path(a).cmp(&normalized_path(b)));
+
+    let base = if root.is_file() {
+        root.parent().unwrap_or_else(|| Path::new("."))
+    } else {
+        root
+    };
+
+    let mut findings = Vec::new();
+    let mut diagnostics = Vec::new();
+    let mut scanned_files = 0usize;
+    let mut skipped_files = 0usize;
+    let mut bytes_scanned = 0u64;
+
+    for file in files {
+        let relative = file
+            .strip_prefix(base)
+            .map_or_else(|_| normalized_path(&file), normalized_path);
+        let metadata = match fs::metadata(&file) {
+            Ok(metadata) => metadata,
+            Err(error) => {
+                skipped_files += 1;
+                diagnostics.push(Diagnostic {
+                    path: relative,
+                    message: format!("metadata unavailable: {error}"),
+                });
+                continue;
+            }
+        };
+        if metadata.len() > config.max_file_bytes {
+            skipped_files += 1;
+            diagnostics.push(Diagnostic {
+                path: relative,
+                message: format!(
+                    "file exceeds max size: {} > {} bytes",
+                    metadata.len(),
+                    config.max_file_bytes
+                ),
+            });
+            continue;
+        }
+        let bytes = match fs::read(&file) {
+            Ok(bytes) => bytes,
+            Err(error) => {
+                skipped_files += 1;
+                diagnostics.push(Diagnostic {
+                    path: relative,
+                    message: format!("read failed: {error}"),
+                });
+                continue;
+            }
+        };
+        let source = match std::str::from_utf8(&bytes) {
+            Ok(source) => source,
+            Err(_) => {
+                skipped_files += 1;
+                diagnostics.push(Diagnostic {
+                    path: relative,
+                    message: "not UTF-8; skipped rather than lossy-decoded".to_string(),
+                });
+                continue;
+            }
+        };
+        let Some(language) = language_for_path(&file) else {
+            continue;
+        };
+        bytes_scanned = bytes_scanned.saturating_add(metadata.len());
+        scanned_files += 1;
+        findings.extend(analyze_source(
+            &relative,
+            source,
+            language,
+            config.context_lines,
+        ));
+    }
+
+    findings.sort_by(|a, b| {
+        a.path
+            .cmp(&b.path)
+            .then(a.line.cmp(&b.line))
+            .then(a.rule_id.cmp(b.rule_id))
+    });
+    diagnostics.sort_by(|a, b| a.path.cmp(&b.path).then(a.message.cmp(&b.message)));
+
+    Ok(AuditReport {
+        schema_version: SCHEMA_VERSION,
+        root: normalized_path(root),
+        snapshot: git_snapshot(root),
+        scanned_files,
+        skipped_files,
+        bytes_scanned,
+        findings,
+        diagnostics,
+    })
+}
+
+fn collect_source_files(path: &Path, out: &mut Vec<PathBuf>) -> io::Result<()> {
+    if path.is_file() {
+        if language_for_path(path).is_some() {
+            out.push(path.to_path_buf());
+        }
+        return Ok(());
+    }
+
+    let mut entries = fs::read_dir(path)?.collect::<Result<Vec<_>, _>>()?;
+    entries.sort_by_key(std::fs::DirEntry::file_name);
+    for entry in entries {
+        let child = entry.path();
+        let file_type = entry.file_type()?;
+        if file_type.is_dir() {
+            let name = entry.file_name();
+            let name = name.to_string_lossy();
+            if ignored_dir(&name) {
+                continue;
+            }
+            collect_source_files(&child, out)?;
+        } else if file_type.is_file() && language_for_path(&child).is_some() {
+            out.push(child);
+        }
+    }
+    Ok(())
+}
+
+fn ignored_dir(name: &str) -> bool {
+    matches!(
+        name,
+        ".git" | "target" | "node_modules" | "vendor" | "dist" | "build" | ".worktrees"
+    )
+}
+
+fn language_for_path(path: &Path) -> Option<Language> {
+    match path.extension().and_then(std::ffi::OsStr::to_str)? {
+        "rs" => Some(Language::Rust),
+        "c" | "h" | "cc" | "cpp" | "cxx" | "hh" | "hpp" => Some(Language::CLike),
+        _ => None,
+    }
+}
+
+fn normalized_path(path: &Path) -> String {
+    path.to_string_lossy().replace('\\', "/")
+}
+
+#[cfg(test)]
+fn analyze_source_for_tests(path: &str, source: &str, context_lines: usize) -> Vec<Finding> {
+    let language = if path.ends_with(".rs") {
+        Language::Rust
+    } else {
+        Language::CLike
+    };
+    analyze_source(path, source, language, context_lines)
+}
+
+fn analyze_source(path: &str, source: &str, language: Language, context_lines: usize) -> Vec<Finding> {
+    let lines = source.lines().collect::<Vec<_>>();
+    let comments = comment_lines(&lines);
+    let mut findings = Vec::new();
+
+    detect_remove_vs_xor(path, &lines, &comments, context_lines, &mut findings);
+    detect_case_insensitive_exact_compare(path, &lines, &comments, context_lines, &mut findings);
+    detect_mixed_time_unit_compare(path, &lines, context_lines, &mut findings);
+    if language == Language::CLike {
+        detect_optional_pointer_deref(path, &lines, &comments, context_lines, &mut findings);
+    }
+
+    findings
+}
+
+fn detect_remove_vs_xor(
+    path: &str,
+    lines: &[&str],
+    comments: &[Option<String>],
+    context_lines: usize,
+    out: &mut Vec<Finding>,
+) {
+    const RULE: &str = "intent.remove_vs_xor";
+    for (index, line) in lines.iter().enumerate() {
+        let code = code_without_line_comment(line);
+        if !code.contains("^=") {
+            continue;
+        }
+        let Some(comment_index) = preceding_comment_matching(comments, index, 4, |comment| {
+            contains_any_word(comment, &["remove", "disable", "clear", "unset", "exclude", "drop"])
+        }) else {
+            continue;
+        };
+        out.push(Finding {
+            id: finding_id(RULE, path, index + 1),
+            state: FindingState::Candidate,
+            rule_id: RULE,
+            class: ContradictionClass::IntentVsImplementation,
+            priority: Priority::High,
+            path: path.to_string(),
+            line: index + 1,
+            summary: "removal/disable intent is implemented with XOR toggling".to_string(),
+            rationale: "XOR toggles selected bits; it does not guarantee they are cleared. If any selected bit is already clear, ^= sets it, contradicting a remove/disable/clear postcondition.".to_string(),
+            evidence: evidence_span(&lines, comment_index, index, context_lines),
+            verification: vec![
+                "Trace every reaching definition of the XOR mask and target value.".to_string(),
+                "Construct a case where one selected bit is already clear and observe the post-state.".to_string(),
+                "Compare the observed post-state with the documented remove/disable/clear contract.".to_string(),
+            ],
+            falsification: vec![
+                "Prove an invariant that every bit present in the mask is always set in the target before this operation on every reachable path.".to_string(),
+                "Or prove the comment describes intentional toggling rather than a required cleared post-state.".to_string(),
+            ],
+        });
+    }
+}
+
+fn detect_case_insensitive_exact_compare(
+    path: &str,
+    lines: &[&str],
+    comments: &[Option<String>],
+    context_lines: usize,
+    out: &mut Vec<Finding>,
+) {
+    const RULE: &str = "contract.case_insensitive_exact_compare";
+    for (index, line) in lines.iter().enumerate() {
+        let code = code_without_line_comment(line);
+        let lower = code.to_ascii_lowercase();
+        if lower.contains("eq_ignore_ascii_case")
+            || lower.contains("strcasecmp(")
+            || lower.contains("strncasecmp(")
+            || lower.contains("tolower(")
+            || lower.contains("toupper(")
+            || lower.contains(".to_ascii_lowercase()")
+            || lower.contains(".to_ascii_uppercase()")
+        {
+            continue;
+        }
+        let looks_exact = code.contains("== \"")
+            || code.contains("!= \"")
+            || lower.contains("strcmp(")
+            || lower.contains("strncmp(")
+            || code.contains(".starts_with(\"")
+            || code.contains(".ends_with(\"");
+        if !looks_exact {
+            continue;
+        }
+        let Some(comment_index) = preceding_comment_matching(comments, index, 12, |comment| {
+            let lower = comment.to_ascii_lowercase();
+            lower.contains("case-insensitive") || lower.contains("case insensitive")
+        }) else {
+            continue;
+        };
+        out.push(Finding {
+            id: finding_id(RULE, path, index + 1),
+            state: FindingState::Candidate,
+            rule_id: RULE,
+            class: ContradictionClass::ContractVsImplementation,
+            priority: Priority::High,
+            path: path.to_string(),
+            line: index + 1,
+            summary: "case-insensitive contract is followed by an exact string comparison".to_string(),
+            rationale: "An exact comparison can reject a differently-cased token even when the surrounding contract says matching is case-insensitive. Normalization elsewhere may make this safe, so this remains a candidate until data flow is checked.".to_string(),
+            evidence: evidence_span(lines, comment_index, index, context_lines),
+            verification: vec![
+                "Trace the compared value from input to this comparison and record every normalization step.".to_string(),
+                "Exercise at least one valid differently-cased token through the real parser/state machine.".to_string(),
+                "Check the governing protocol/API specification for the token's case-sensitivity requirement.".to_string(),
+            ],
+            falsification: vec![
+                "Prove all reaching values are canonicalized to the compared case before this line.".to_string(),
+                "Or prove the specific token is case-sensitive despite broader case-insensitive protocol text.".to_string(),
+            ],
+        });
+    }
+}
+
+fn detect_mixed_time_unit_compare(
+    path: &str,
+    lines: &[&str],
+    context_lines: usize,
+    out: &mut Vec<Finding>,
+) {
+    const RULE: &str = "units.mixed_time_compare";
+    for (index, line) in lines.iter().enumerate() {
+        let code = code_without_line_comment(line);
+        if !has_comparison_operator(code) {
+            continue;
+        }
+        if code.contains("as_nanos")
+            || code.contains("as_micros")
+            || code.contains("as_millis")
+            || code.contains("as_secs")
+            || code.contains("Duration::from_")
+        {
+            continue;
+        }
+        let units = time_units_in_code(code);
+        if units.len() < 2 {
+            continue;
+        }
+        let joined = units.iter().copied().collect::<Vec<_>>().join(", ");
+        out.push(Finding {
+            id: finding_id(RULE, path, index + 1),
+            state: FindingState::Candidate,
+            rule_id: RULE,
+            class: ContradictionClass::UnitConsistency,
+            priority: Priority::Medium,
+            path: path.to_string(),
+            line: index + 1,
+            summary: format!("comparison mixes time-unit-labelled values ({joined})"),
+            rationale: "Comparing values labelled with different time units without an explicit conversion is dimensionally suspicious. This is the class of defect where nanoseconds can be compared as milliseconds/seconds and silently distort timeout behaviour.".to_string(),
+            evidence: evidence_span(lines, index, index, context_lines),
+            verification: vec![
+                "Trace the concrete units of each operand back to its producer/API.".to_string(),
+                "Rewrite the comparison dimensionally on paper and confirm both operands are expressed in the same unit.".to_string(),
+                "Exercise a boundary timeout where the unit mismatch would change the branch outcome.".to_string(),
+            ],
+            falsification: vec![
+                "Prove the differently named operands are already normalized to the same unit before this comparison.".to_string(),
+                "Or identify an explicit conversion hidden behind a called helper and verify its ratio.".to_string(),
+            ],
+        });
+    }
+}
+
+fn detect_optional_pointer_deref(
+    path: &str,
+    lines: &[&str],
+    comments: &[Option<String>],
+    context_lines: usize,
+    out: &mut Vec<Finding>,
+) {
+    const RULE: &str = "contract.optional_pointer_deref";
+    for (comment_index, comment) in comments.iter().enumerate() {
+        let Some(comment) = comment else {
+            continue;
+        };
+        let lower = comment.to_ascii_lowercase();
+        let optional_contract = lower.contains("optional")
+            || lower.contains("may be null")
+            || lower.contains("can be null")
+            || lower.contains("may be nullptr")
+            || lower.contains("if one is provided")
+            || lower.contains("if provided");
+        if !optional_contract {
+            continue;
+        }
+        let comment_context = nearby_comment_context(comments, comment_index, 4);
+        let identifiers = documented_identifiers(&comment_context);
+        if identifiers.is_empty() {
+            continue;
+        }
+        for identifier in identifiers {
+            if comment_index + 1 >= lines.len() {
+                continue;
+            }
+            let end = (comment_index + 80).min(lines.len() - 1);
+            for index in comment_index + 1..=end {
+                let code = code_without_line_comment(lines[index]);
+                if !looks_like_pointer_deref(code, &identifier) {
+                    continue;
+                }
+                if pointer_guard_seen(lines, comment_index + 1, index, &identifier) {
+                    break;
+                }
+                out.push(Finding {
+                    id: finding_id(RULE, path, index + 1),
+                    state: FindingState::Candidate,
+                    rule_id: RULE,
+                    class: ContradictionClass::ContractVsImplementation,
+                    priority: Priority::High,
+                    path: path.to_string(),
+                    line: index + 1,
+                    summary: format!(
+                        "optional pointer `{identifier}` appears to be dereferenced without a preceding null guard"
+                    ),
+                    rationale: "The nearby contract permits an absent/null pointer, while this dereference requires a valid object. The check is deliberately conservative and must be falsified by proving a dominating guard or a stronger caller invariant.".to_string(),
+                    evidence: evidence_span(lines, comment_index, index, context_lines),
+                    verification: vec![
+                        format!("Trace every caller that can pass `{identifier}` and determine whether null is reachable."),
+                        format!("Prove whether a dominating guard protects `{identifier}` on every path to this dereference."),
+                        "Exercise the documented absent/null case under ASan/UBSan or an equivalent memory-safety harness where applicable.".to_string(),
+                    ],
+                    falsification: vec![
+                        format!("Prove a dominating non-null check for `{identifier}` on every path to this line."),
+                        "Or correct/clarify the contract if null is not actually permitted.".to_string(),
+                    ],
+                });
+                break;
+            }
+        }
+    }
+}
+
+fn comment_lines(lines: &[&str]) -> Vec<Option<String>> {
+    let mut result = Vec::with_capacity(lines.len());
+    let mut in_block = false;
+    for line in lines {
+        let trimmed = line.trim();
+        if in_block {
+            let content = trimmed
+                .trim_start_matches('*')
+                .split("*/")
+                .next()
+                .unwrap_or("")
+                .trim();
+            result.push((!content.is_empty()).then(|| content.to_string()));
+            if trimmed.contains("*/") {
+                in_block = false;
+            }
+            continue;
+        }
+        if let Some(rest) = trimmed.strip_prefix("//") {
+            let rest = rest.trim_start_matches(['/', '!']).trim();
+            result.push((!rest.is_empty()).then(|| rest.to_string()));
+            continue;
+        }
+        if let Some(rest) = trimmed.strip_prefix("/*") {
+            let content = rest.split("*/").next().unwrap_or("").trim();
+            result.push((!content.is_empty()).then(|| content.to_string()));
+            if !rest.contains("*/") {
+                in_block = true;
+            }
+            continue;
+        }
+        result.push(None);
+    }
+    result
+}
+
+fn preceding_comment_matching<F>(
+    comments: &[Option<String>],
+    index: usize,
+    max_lines: usize,
+    predicate: F,
+) -> Option<usize>
+where
+    F: Fn(&str) -> bool,
+{
+    let start = index.saturating_sub(max_lines);
+    (start..index)
+        .rev()
+        .find(|&candidate| comments[candidate].as_deref().is_some_and(&predicate))
+}
+
+fn contains_any_word(haystack: &str, needles: &[&str]) -> bool {
+    let lower = haystack.to_ascii_lowercase();
+    lower
+        .split(|ch: char| !ch.is_ascii_alphanumeric() && ch != '_')
+        .any(|word| needles.contains(&word))
+}
+
+fn code_without_line_comment(line: &str) -> &str {
+    line.split_once("//").map_or(line, |(code, _)| code)
+}
+
+fn evidence_span(lines: &[&str], first: usize, last: usize, context: usize) -> EvidenceSpan {
+    if lines.is_empty() {
+        return EvidenceSpan {
+            start_line: 0,
+            end_line: 0,
+            excerpt: String::new(),
+        };
+    }
+    let start = first.saturating_sub(context);
+    let end = (last + context).min(lines.len() - 1);
+    let mut excerpt = String::new();
+    for (index, line) in lines.iter().enumerate().take(end + 1).skip(start) {
+        excerpt.push_str(&format!("{:>6} | {}\n", index + 1, line));
+    }
+    EvidenceSpan {
+        start_line: start + 1,
+        end_line: end + 1,
+        excerpt,
+    }
+}
+
+fn finding_id(rule: &str, path: &str, line: usize) -> String {
+    format!("{rule}:{path}:{line}")
+}
+
+fn has_comparison_operator(code: &str) -> bool {
+    code.contains("==")
+        || code.contains("!=")
+        || code.contains("<=")
+        || code.contains(">=")
+        || code.contains(" < ")
+        || code.contains(" > ")
+}
+
+fn time_units_in_code(code: &str) -> BTreeSet<&'static str> {
+    code.split(|ch: char| !ch.is_ascii_alphanumeric() && ch != '_')
+        .filter_map(time_unit_for_identifier)
+        .collect()
+}
+
+fn time_unit_for_identifier(identifier: &str) -> Option<&'static str> {
+    let lower = identifier.to_ascii_lowercase();
+    let matches_suffix = |suffixes: &[&str]| suffixes.iter().any(|suffix| lower.ends_with(suffix));
+
+    if matches_suffix(&["_ns", "_nano", "_nanos", "_nanosecond", "_nanoseconds"]) {
+        Some("nanoseconds")
+    } else if matches_suffix(&["_us", "_micro", "_micros", "_microsecond", "_microseconds"]) {
+        Some("microseconds")
+    } else if matches_suffix(&["_ms", "_milli", "_millis", "_millisecond", "_milliseconds"]) {
+        Some("milliseconds")
+    } else if matches_suffix(&["_s", "_sec", "_secs", "_second", "_seconds"]) {
+        Some("seconds")
+    } else if matches_suffix(&["_min", "_mins", "_minute", "_minutes"]) {
+        Some("minutes")
+    } else if matches_suffix(&["_h", "_hr", "_hrs", "_hour", "_hours"]) {
+        Some("hours")
+    } else {
+        None
+    }
+}
+
+fn nearby_comment_context(
+    comments: &[Option<String>],
+    index: usize,
+    radius: usize,
+) -> String {
+    let start = index.saturating_sub(radius);
+    let end = (index + radius).min(comments.len().saturating_sub(1));
+    comments[start..=end]
+        .iter()
+        .filter_map(Option::as_deref)
+        .collect::<Vec<_>>()
+        .join(" ")
+}
+
+fn documented_identifiers(comment: &str) -> Vec<String> {
+    let mut identifiers = Vec::new();
+    for delimiter in ['`', '\'', '"'] {
+        let mut rest = comment;
+        while let Some(start) = rest.find(delimiter) {
+            let after = &rest[start + delimiter.len_utf8()..];
+            let Some(end) = after.find(delimiter) else {
+                break;
+            };
+            let candidate = &after[..end];
+            if is_identifier(candidate) {
+                identifiers.push(candidate.to_string());
+            }
+            rest = &after[end + delimiter.len_utf8()..];
+        }
+    }
+    identifiers.sort();
+    identifiers.dedup();
+    identifiers
+}
+
+fn is_identifier(value: &str) -> bool {
+    let mut chars = value.chars();
+    let Some(first) = chars.next() else {
+        return false;
+    };
+    (first.is_ascii_alphabetic() || first == '_')
+        && chars.all(|ch| ch.is_ascii_alphanumeric() || ch == '_')
+}
+
+fn looks_like_pointer_deref(code: &str, identifier: &str) -> bool {
+    let compact = code.chars().filter(|ch| !ch.is_whitespace()).collect::<String>();
+    compact.contains(&format!("*{identifier}="))
+        || compact.contains(&format!("*{identifier};"))
+        || compact.contains(&format!("{identifier}->"))
+}
+
+fn pointer_guard_seen(lines: &[&str], start: usize, end: usize, identifier: &str) -> bool {
+    let patterns = [
+        format!("if({identifier})"),
+        format!("if(!{identifier})"),
+        format!("{identifier}!=NULL"),
+        format!("{identifier}==NULL"),
+        format!("{identifier}!=nullptr"),
+        format!("{identifier}==nullptr"),
+    ];
+    lines[start..end].iter().any(|line| {
+        let compact = code_without_line_comment(line)
+            .chars()
+            .filter(|ch| !ch.is_whitespace())
+            .collect::<String>();
+        patterns.iter().any(|pattern| compact.contains(pattern))
+    })
+}
+
+fn git_snapshot(root: &Path) -> SnapshotState {
+    let working_dir = if root.is_dir() {
+        root
+    } else {
+        root.parent().unwrap_or_else(|| Path::new("."))
+    };
+    let head = Command::new("git")
+        .arg("-C")
+        .arg(working_dir)
+        .args(["rev-parse", "HEAD"])
+        .output()
+        .ok()
+        .filter(|output| output.status.success())
+        .and_then(|output| String::from_utf8(output.stdout).ok())
+        .map(|value| value.trim().to_string())
+        .filter(|value| !value.is_empty());
+    let dirty = Command::new("git")
+        .arg("-C")
+        .arg(working_dir)
+        .args(["status", "--porcelain", "--untracked-files=normal"])
+        .output()
+        .ok()
+        .filter(|output| output.status.success())
+        .map(|output| !output.stdout.is_empty());
+    SnapshotState {
+        git_head: head,
+        dirty,
+    }
+}
+
+pub fn render_text(report: &AuditReport) -> String {
+    let mut output = String::new();
+    output.push_str("HSE source-audit\n");
+    output.push_str(&format!("schema: {}\n", report.schema_version));
+    output.push_str(&format!("root: {}\n", report.root));
+    match (&report.snapshot.git_head, report.snapshot.dirty) {
+        (Some(head), Some(true)) => output.push_str(&format!("snapshot: {head} + dirty (SHA alone is not replayable)\n")),
+        (Some(head), Some(false)) => output.push_str(&format!("snapshot: {head} (clean)\n")),
+        (Some(head), None) => output.push_str(&format!("snapshot: {head} (dirty state unavailable)\n")),
+        (None, _) => output.push_str("snapshot: git metadata unavailable\n"),
+    }
+    output.push_str(&format!(
+        "scanned: {} files / {} bytes; skipped: {}; candidates: {}\n",
+        report.scanned_files,
+        report.bytes_scanned,
+        report.skipped_files,
+        report.findings.len()
+    ));
+
+    let mut counts = BTreeMap::<&str, usize>::new();
+    for finding in &report.findings {
+        *counts.entry(finding.rule_id).or_default() += 1;
+    }
+    if !counts.is_empty() {
+        output.push_str("rules:\n");
+        for (rule, count) in counts {
+            output.push_str(&format!("  {rule}: {count}\n"));
+        }
+    }
+
+    for finding in &report.findings {
+        output.push_str(&format!(
+            "\n[{}] {} {}:{}\n",
+            finding.priority.as_str().to_ascii_uppercase(),
+            finding.rule_id,
+            finding.path,
+            finding.line
+        ));
+        output.push_str(&format!(
+            "state: {}\nclass: {}\n",
+            finding.state.as_str(),
+            finding.class.as_str()
+        ));
+        output.push_str(&format!("summary: {}\n", finding.summary));
+        output.push_str(&format!("rationale: {}\n", finding.rationale));
+        output.push_str("evidence:\n");
+        output.push_str(&finding.evidence.excerpt);
+        output.push_str("verify:\n");
+        for item in &finding.verification {
+            output.push_str(&format!("  - {item}\n"));
+        }
+        output.push_str("falsify:\n");
+        for item in &finding.falsification {
+            output.push_str(&format!("  - {item}\n"));
+        }
+    }
+
+    if !report.diagnostics.is_empty() {
+        output.push_str("\ndiagnostics:\n");
+        for diagnostic in &report.diagnostics {
+            output.push_str(&format!("  - {}: {}\n", diagnostic.path, diagnostic.message));
+        }
+    }
+    output
+}
+
+pub fn render_json(report: &AuditReport) -> Result<String, serde_json::Error> {
+    serde_json::to_string_pretty(report)
+}
