#!/data/data/com.termux/files/usr/bin/bash
# huntsman: one command for Huntsman on Termux. install.sh installs it as
# $PREFIX/bin/huntsman. The web UI runs as the termux-services service
# huntsman-serve, which runit restarts whenever it stops; this script starts,
# stops and inspects that service, runs scans, and passes every other command
# to huntsman-recon.
set -Eeuo pipefail
# Saved scans and generated reports can contain personal investigative data.
umask 077

PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
RECON="${HUNTSMAN_RECON:-huntsman-recon}"
REPORTS_DIR="${HUNTSMAN_REPORTS:-$HOME/huntsman-reports}"
SERVICE="${SVDIR:-$PREFIX/var/service}/huntsman-serve"
SERVICE_LOG="$PREFIX/var/log/sv/huntsman-serve/current"

# The state directory install.sh wrote into the service's run script, if any.
service_state_dir() {
  local line
  line="$(grep -m 1 '^export HUNTSMAN_HOME=' "$SERVICE/run" 2>/dev/null)" || return 1
  line="${line#export HUNTSMAN_HOME=}"
  line="${line#\'}"
  printf '%s' "${line%\'}"
}
# The state directory: HUNTSMAN_HOME, else the service's, else ~/.huntsman. Exported, so the
# commands passed on to huntsman-recon read the serve.bind and scan store the service keeps,
# whether or not this shell exports HUNTSMAN_HOME.
STATE_DIR="${HUNTSMAN_HOME:-$(service_state_dir || printf '%s' "$HOME/.huntsman")}"
export HUNTSMAN_HOME="$STATE_DIR"
# The address the service binds. The run script reads this file, so a port
# chosen here survives restarts and reboots.
BIND_FILE="$STATE_DIR/serve.bind"
DEFAULT_BIND="127.0.0.1:8080"

if [[ -t 1 ]]; then
  C_BLU=$'\033[1;34m' C_GRN=$'\033[1;32m' C_YEL=$'\033[1;33m' C_RED=$'\033[1;31m' C_RST=$'\033[0m'
else
  C_BLU='' C_GRN='' C_YEL='' C_RED='' C_RST=''
fi
say() { printf '%s[+]%s %s\n' "$C_BLU" "$C_RST" "$*"; }
ok() { printf '%s[✓]%s %s\n' "$C_GRN" "$C_RST" "$*"; }
warn() { printf '%s[!]%s %s\n' "$C_YEL" "$C_RST" "$*" >&2; }
die() {
  printf '%s[-]%s %s\n' "$C_RED" "$C_RST" "$*" >&2
  exit 1
}

bind() {
  local b=""
  [[ -r "$BIND_FILE" ]] && b="$(head -n 1 "$BIND_FILE")"
  printf '%s' "${b:-$DEFAULT_BIND}"
}

# The state `doctor serve` reports for ADDR: healthy, not_running, foreign,
# unauthorized or degraded.
probe() {
  local line
  line="$("$RECON" doctor serve --bind "$1" 2>/dev/null | head -n 1)" || true
  line="${line%% *}"
  printf '%s' "${line#serve=}"
}

need_service() {
  [[ -f "$SERVICE/run" ]] ||
    die "the huntsman-serve service is not set up; run the installer again (see docs/INSTALL.md)"
  command -v sv >/dev/null 2>&1 || die "termux-services is not installed: pkg install termux-services"
}

supervised() { sv status "$SERVICE" >/dev/null 2>&1; }

service_pid() {
  local status
  status="$(sv status "$SERVICE" 2>/dev/null)" || return 1
  [[ "$status" =~ ^run:\ [^:]*:\ \(pid\ ([0-9]+)\) ]] || return 1
  printf '%s' "${BASH_REMATCH[1]}"
}

# A server started by hand or by the earlier nohup controller holds the port
# outside runit. Stop it, so the service owns the web UI.
stop_unsupervised() {
  local pid_file="$STATE_DIR/daemon.pid" pid
  if [[ -r "$pid_file" ]]; then
    pid="$(head -n 1 "$pid_file")"
    if [[ "$pid" =~ ^[0-9]+$ ]] && tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -q " serve"; then
      kill "$pid" 2>/dev/null || true
      # Wait until it lets go of the port, or the service finds it taken.
      for _ in {1..20}; do kill -0 "$pid" 2>/dev/null || break; sleep 0.25; done
      kill -9 "$pid" 2>/dev/null || true
      say "stopped the server the old controller started (pid $pid)"
    fi
    rm -f "$pid_file" "$STATE_DIR/daemon.port"
  fi
}

# The first port from the bound one up whose address nothing answers on.
free_bind() {
  local host="${1%:*}" port="${1##*:}" i
  for ((i = 1; i <= 20; i++)); do
    if [[ "$(probe "$host:$((port + i))")" == not_running ]]; then
      printf '%s' "$host:$((port + i))"
      return 0
    fi
  done
  return 1
}

wait_healthy() {
  local addr="$1" deadline=$((SECONDS + ${HUNTSMAN_START_TIMEOUT:-15})) state=""
  while ((SECONDS < deadline)); do
    state="$(probe "$addr")"
    [[ "$state" == healthy ]] && return 0
    sleep 0.5
  done
  printf '%s' "$state"
  return 1
}

cmd_start() {
  need_service
  local addr state
  addr="$(bind)"
  stop_unsupervised
  rm -f "$SERVICE/down"
  if ! supervised; then
    SVDIR="${SERVICE%/*}" service-daemon start >/dev/null 2>&1 || true
    for _ in {1..20}; do supervised && break; sleep 0.5; done
  fi
  supervised || die "runit is not supervising $SERVICE; open a new Termux session and try again"
  if [[ -z "$(service_pid)" ]]; then
    # Back to the default port once whatever took it has gone.
    if [[ "$addr" != "$DEFAULT_BIND" && "$(probe "$DEFAULT_BIND")" == not_running ]]; then
      rm -f "$BIND_FILE"
      addr="$DEFAULT_BIND"
    fi
    state="$(probe "$addr")"
    if [[ -n "$state" && "$state" != not_running ]]; then
      # Another program, or a Huntsman server outside runit, holds the port.
      local next
      next="$(free_bind "$addr")" || die "no free port near $addr"
      warn "$addr is taken by another program; using $next"
      mkdir -p "$STATE_DIR"
      printf '%s\n' "$next" > "$BIND_FILE"
      addr="$next"
    fi
  fi
  # After a failed start, finish waits a minute before runit retries; cut that
  # wait short, since the port was just checked.
  local st
  st="$(sv status "$SERVICE" 2>/dev/null)" || st=""
  [[ "$st" =~ ^finish:\ [^:]*:\ \(pid\ ([0-9]+)\) ]] && kill "${BASH_REMATCH[1]}" 2>/dev/null  || true
  # sv waits only seven seconds; wait_healthy below decides.
  sv "${1:-up}" "$SERVICE" >/dev/null 2>&1 || true
  if state="$(wait_healthy "$addr")"; then
    ok "web UI running: http://$addr/ (restarts automatically)"
  else
    printf '%s[-]%s web UI not answering at %s (%s). Recent log:\n' "$C_RED" "$C_RST" "$addr" "${state:-no answer}" >&2
    tail -n 8 "$SERVICE_LOG" >&2 2>/dev/null || true
    exit 1
  fi
}

cmd_stop() {
  need_service
  # The down file keeps it off across reboots and reinstalls.
  : > "$SERVICE/down"
  sv down "$SERVICE" >/dev/null 2>&1 || true
  stop_unsupervised
  if command -v termux-wake-unlock >/dev/null 2>&1; then termux-wake-unlock >/dev/null 2>&1 || true; fi
  ok "web UI stopped; it stays off until: huntsman start"
}

cmd_status() {
  need_service
  local addr pid state
  addr="$(bind)"
  pid="$(service_pid)" || pid=""
  state="$(probe "$addr")"
  if [[ -n "$pid" ]]; then
    printf '%sweb UI: RUNNING%s (%s)\n' "$C_GRN" "$C_RST" "${state:-unknown}"
    printf '  PID:      %s\n' "$pid"
    printf '  RAM:      %s\n' "$(awk '/^VmRSS/ {print $2, $3}' "/proc/$pid/status" 2>/dev/null || echo n/a)"
    printf '  Threads:  %s\n' "$(awk '/^Threads/ {print $2}' "/proc/$pid/status" 2>/dev/null || echo n/a)"
  elif [[ -e "$SERVICE/down" ]]; then
    printf '%sweb UI: STOPPED%s (start it with: huntsman start)\n' "$C_RED" "$C_RST"
  else
    printf '%sweb UI: NOT RUNNING%s (%s); see: huntsman logs\n' "$C_YEL" "$C_RST" "${state:-unknown}"
  fi
  printf '  Endpoint: http://%s/\n' "$addr"
  printf '  Log:      %s\n' "$SERVICE_LOG"
  [[ -n "$pid" && "$state" == healthy ]]
}

# Opens the page in the phone's browser. A loopback server needs no token.
cmd_open() {
  local url
  url="http://$(bind)/"
  command -v termux-open-url >/dev/null 2>&1 ||
    die "termux-open-url is missing (pkg install termux-api); open $url in the browser"
  termux-open-url "$url" ||
    die "could not open the browser; is the Termux:API app installed? The page is at $url"
  ok "opened $url"
}

cmd_logs() {
  [[ -e "$SERVICE_LOG" ]] || die "no service log yet at $SERVICE_LOG"
  exec tail -n 50 -f "$SERVICE_LOG"
}

cmd_clean() {
  # A prebuilt install never compiles, so the Rust build cache is dead weight.
  local cache="${CARGO_TARGET_DIR:-$HOME/.cache/huntsman-recon-target}"
  rm -rf "$cache" "${TMPDIR:-$PREFIX/tmp}"/huntsman-* 2>/dev/null || true
  ok "removed $cache and Huntsman temporary files (runit rotates the service log itself)"
}

# Keep filenames bounded on Android filesystems, including very long or Unicode selectors.
safe_name() { printf '%s' "$1" | LC_ALL=C tr -c 'A-Za-z0-9@._+-' '_' | cut -b 1-64; }

cmd_scan_pipe() {
  local target="${1:-}" kind="${2:-}" out result
  local -a scan_args
  [[ -n "$target" ]] || die "usage: huntsman scan-pipe TARGET [KIND]"
  mkdir -p -- "$REPORTS_DIR"
  # Reserve a unique private filename atomically. A timestamp alone overwrote
  # a prior scan of the same target when both started within one second.
  # GNU mktemp (Termux coreutils) keeps the .json suffix used by latest_json.
  out="$(mktemp --suffix=.json "$REPORTS_DIR/$(safe_name "$target")_$(date -u +%Y%m%d_%H%M%S)_XXXXXX")" ||
    die "cannot reserve an evidence filename in $REPORTS_DIR"
  scan_args=("$target")
  [[ -z "$kind" ]] || scan_args+=(-k "$kind")
  say "scanning $target${kind:+ as $kind}"
  if "$RECON" scan "${scan_args[@]}" --save "$out"; then
    cmd_report "$out"
  else
    result=$?
    # Preserve a nonempty partial ledger for diagnosis; discard only our
    # untouched zero-byte reservation when the scan never wrote anything.
    [[ -s "$out" ]] || rm -f -- "$out"
    die "scan failed (exit $result); any saved output remains at $out"
  fi
}

cmd_report() {
  local file="${1:-}" md verdict
  [[ -n "$file" && -f "$file" ]] || die "usage: huntsman report SCAN.json"
  md="${file%.json}.md"
  if verdict="$("$RECON" verify "$file" 2>&1)"; then
    verdict="verified ($(printf '%s' "$verdict" | tr '\n' ' ' | sed 's/ *$//'))"
  else
    verdict="FAILED: $(printf '%s' "$verdict" | tr '\n' ' ' | sed 's/ *$//')"
  fi
  {
    printf '# Huntsman report\n\n'
    printf -- '- Generated: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf -- '- Ledger: `%s`\n' "$(basename "$file")"
    printf -- '- Ledger check: %s\n\n' "$verdict"
    printf '## Evidence\n\n```json\n'
    cat "$file"
    printf '\n```\n'
  } > "$md"
  if command -v termux-clipboard-set >/dev/null 2>&1 && termux-clipboard-set < "$md" 2>/dev/null; then
    ok "report: $md (copied to the clipboard)"
  else
    ok "report: $md"
  fi
  [[ "$verdict" == verified* ]] || die "the ledger did not verify; the report says why"
}

usage() {
  cat <<'USAGE'
huntsman: Huntsman on Termux

Web UI (a background service that restarts itself):
  huntsman start | stop | restart | status | logs
  huntsman open                  open the page in the browser
  huntsman clean                 remove the Rust build cache and temp files

Scans:
  huntsman scan TARGET [-k KIND]   any selector; the kind is detected
  huntsman scan-pipe TARGET [KIND] scan, save, verify the ledger, write a report
  huntsman report SCAN.json        Markdown report of a saved scan, unredacted

Everything else goes to huntsman-recon, for example:
  huntsman doctor | fix | credential-status | email ADDR | domain NAME
USAGE
}

case "${1:-status}" in
  start) cmd_start up ;;
  restart) cmd_start restart ;;
  stop) cmd_stop ;;
  status) cmd_status ;;
  logs) cmd_logs ;;
  open) cmd_open ;;
  clean) cmd_clean ;;
  scan-pipe) shift; cmd_scan_pipe "$@" ;;
  report) shift; cmd_report "$@" ;;
  help | -h | --help) usage ;;
  *) exec "$RECON" "$@" ;;
esac
