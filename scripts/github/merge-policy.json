{
  "name": "Huntsman main verified PR merge",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/main"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_approving_review_count": 0,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "test (1.87)",
            "integration_id": 15368
          },
          {
            "context": "test (1.99)",
            "integration_id": 15368
          },
          {
            "context": "Android aarch64 cross-build",
            "integration_id": 15368
          },
          {
            "context": "Library tests on aarch64 under qemu",
            "integration_id": 15368
          },
          {
            "context": "Web UI in a phone browser",
            "integration_id": 15368
          },
          {
            "context": "Self-hosted container smoke test",
            "integration_id": 15368
          },
          {
            "context": "Canonical Huntsman directive lock",
            "integration_id": 15368
          },
          {
            "context": "Offline MITM eligibility fixtures",
            "integration_id": 15368
          },
          {
            "context": "Generate the full repository completion register",
            "integration_id": 15368
          }
        ]
      }
    }
  ]
}
